@startuml "Diagrama Entidad-Relación - Sistema de Aprendizaje de Música"

!define TABLENAME(name) class name << (T,#FFAAAA) >>
!define PRIMARY_KEY(x) {id : x
!define FOREIGN_KEY(x) {x
!define FIELD(x) x :

' Entities Definition
TABLENAME(User) {
    id : Long <<PK>>
    --
    email : String <<UNIQUE>>
    username : String <<UNIQUE>>
    password : String
    name : String
    profileImageUrl : String
    role : Role {ADMIN, USER}
    difficultyLevel : int [0-100]
    createdAt : LocalDateTime
    updatedAt : LocalDateTime
    --
    favoriteGenres : Set<Genre> <<M2M>>
    favoriteInstruments : Set<Instrument> <<M2M>>
    itemLists : List<ItemList>
}

TABLENAME(Item) {
    id : Long <<PK>>
    --
    name : String
    imageUrl : String
    level : int [1-5]
    createdAt : LocalDateTime
    dtype : String <<DISCRIMINATOR>>
    type : Type {Song, Lesson, Genre, InstrumentGenre}
}

TABLENAME(Song) {
    <<extends Item>>
    --
    id : Long <<PK>>
    title : String
    artist : String
    popular : boolean
    decade : String
    genreClassic : boolean
    genrePopular : boolean
    genreNew : boolean
    --
    genres : Set<Genre> <<M2M>>
    instruments : Set<Instrument> <<M2M>>
    lessons : List<SongLesson>
}

TABLENAME(Genre) {
    <<extends Item>>
    --
    id : Long <<PK>>
    description : String
    bannerUrl : String
    welcomeIntroVideo : String
    welcomeSongVideo : String
    --
    songs : Set<Song> <<M2M>>
    lessons : Set<Lesson>
}

TABLENAME(Instrument) {
    id : Long <<PK>>
    --
    name : String <<UNIQUE>>
    imageUrl : String
    --
    songs : Set<Song> <<M2M>>
}

TABLENAME(SongLesson) {
    id : Long <<PK>>
    --
    difficulty : DifficultyLevel {EASY, MEDIUM, ORIGINAL}
    chordedLyrics : String <<LOB>>
    videoUrl : String
    --
    song : Song <<M2O>>
    instrument : Instrument <<M2O>>
    chords : List<Chord> <<M2M>>
    tabSections : List<TabSection>
}

TABLENAME(Chord) {
    id : Long <<PK>>
    --
    name : String <<UNIQUE>>
    imageUrl : String
    notes : List<String>
    open : boolean
    barre : boolean
    powerChord : boolean
    minor : boolean
    major : boolean
    seventh : boolean
    capo : boolean
    capoFret : int
}

TABLENAME(TabSection) {
    id : Long <<PK>>
    --
    identifier : String
    content : String <<LOB>>
    --
    songLesson : SongLesson <<M2O>>
}

TABLENAME(Lesson) {
    <<extends Item>>
    --
    id : Long <<PK>>
    belongsToGenre : boolean
    --
    genre : Genre <<M2O>>
    sections : List<LessonSection>
}

TABLENAME(LessonSection) {
    id : Long <<PK>>
    --
    orderIndex : int
    content : String
    --
    lesson : Lesson <<M2O>>
}

TABLENAME(InstrumentGenre) {
    <<extends Item>>
    --
    id : Long <<PK>>
    --
    instrument : Instrument <<M2O>>
    genre : Genre <<M2O>>
    lessons : Set<Lesson> <<M2M>>
}

TABLENAME(ItemList) {
    id : Long <<PK>>
    --
    name : String
    imageUrl : String
    --
    user : User <<M2O>>
    items : List<Item> <<M2M>>
}

TABLENAME(Role) {
    <<Enum>>
    --
    ADMIN
    USER
}

' Relaciones

User "1" --> "*" ItemList : crea >
User "*" --> "*" Genre : favoritos >
User "*" --> "*" Instrument : favoritos >

Song "1" --> "*" SongLesson : tiene >
SongLesson "1" --> "*" TabSection : contiene >
SongLesson "*" --> "*" Chord : usa >

Song "*" --> "*" Genre : pertenece a >
Song "*" --> "*" Instrument : usa >

Genre "1" --> "*" Lesson : organiza >

Instrument "1" --> "*" SongLesson : enseña >

Lesson "1" --> "*" LessonSection : contiene >

InstrumentGenre "*" --> "*" Lesson : enseña >
InstrumentGenre "*" --> "1" Instrument : es >
InstrumentGenre "*" --> "1" Genre : es >

ItemList "1" --> "*" Item : contiene >

Item <|-- Song
Item <|-- Genre
Item <|-- Lesson
Item <|-- InstrumentGenre

note right of User
    Usuario del sistema con autenticación JWT
    Puede tener géneros e instrumentos favoritos
    Puede crear múltiples listas de items
end note

note right of Song
    Canción con múltiples lecciones
    Puede pertenecer a varios géneros
    Puede usar múltiples instrumentos
end note

note right of SongLesson
    Lección específica para una canción
    Dirigida a un instrumento particular
    Contiene acordes y secciones de tabs
    Tiene diferentes niveles de dificultad
end note

note right of Chord
    Acordes musicales con propiedades
    Almacena notas que forman el acorde
    Propiedades de tipo (mayor, menor, etc.)
end note

note right of Genre
    Género musical (Rock, Pop, Jazz, etc.)
    Tiene lecciones asociadas
    Almacena videos de introducción
end note

note right of Instrument
    Instrumentos musicales (Guitarra, Piano, etc.)
    Relación M2M con canciones
end note

note right of ItemList
    Listas personalizadas creadas por usuarios
    Pueden contener cualquier tipo de Item
    Items se almacenan en tabla intermedia
end note

@enduml

