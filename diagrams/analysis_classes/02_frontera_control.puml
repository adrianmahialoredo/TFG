@startuml DCA-02
title DCA-02 - Diagrama de clases de análisis: fronteras y controles

' Vista BCE: qué frontera usa cada control. Las operaciones de los controles salen
' de los diagramas de secuencia de los casos de uso (diagrams/use_cases); entre
' corchetes, las entidades de DCA-01 que maneja cada uno.
skinparam roundcorner 6
skinparam classAttributeIconSize 0
skinparam nodesep 25
skinparam ranksep 110
skinparam class {
    BackgroundColor<<boundary>> #E3F0FF
    BorderColor<<boundary>> #3D6FA8
    BackgroundColor<<control>> #E6F5E6
    BorderColor<<control>> #3C8A3C
}
hide empty members
left to right direction

' ---------------------------------------------------------------------
' Fronteras con el músico (app móvil)
' ---------------------------------------------------------------------

package "Fronteras con el músico (app móvil)" {
    class RegistroScreen <<boundary>>
    class ModalVerificacionEmail <<boundary>>
    class LoginScreen <<boundary>>
    class PerfilScreen <<boundary>>
    class CatalogoView <<boundary>>
    class AnadirItemsScreen <<boundary>>
    class ListaScreen <<boundary>>
    class RecomendacionesView <<boundary>>
    class SongDetailScreen <<boundary>>
    class ModalAcorde <<boundary>>
    class GenreScreen <<boundary>>
    class ItinerarioInstrumentoScreen <<boundary>>
    class LeccionScreen <<boundary>>
    class AfinadorScreen <<boundary>>
    class MetronomoScreen <<boundary>>
}

' ---------------------------------------------------------------------
' Controles
' ---------------------------------------------------------------------

package "Controles" {
    class GestorAutenticacion <<control>> {
        [User, CodigoVerificacion]
        --
        solicitarCodigo(email)
        registrarUsuario(datos, codigo)
        autenticar(emailOUsuario, pass)
        cerrarSesion()
    }
    class GestorPerfil <<control>> {
        [User, Preferencias]
        --
        obtenerPerfil(userId)
        guardarPreferencias(userId, nivel, favs)
    }
    class GestorCatalogo <<control>> {
        [Item, Lesson, LessonSection]
        --
        filtrarEnMemoriaLocal(query, tipo)
        solicitarDetalleCompleto(id)
    }
    class GestorListas <<control>> {
        [ItemList, Item, User]
        --
        obtenerListas(userId)
        crearLista(userId, nombre, imagen)
        actualizarLista(id, nombre, imagen)
        eliminarLista(id)
        anadirItem(listId, itemId)
        eliminarItem(listId, itemId)
    }
    class MotorRecomendacion <<control>> {
        [User, ItemList, Item]
        --
        pedirRecomendaciones(origenId)
        calcularTopGenerosEInstrumentos()
        ejecutarAlgoritmoNiveles()
        filtrarExclusiones(idsPrevios)
    }
    class GestorCanciones <<control>> {
        [Song, SongLesson, Chord, TabSection]
        --
        solicitarCancion(id)
        obtenerSongLesson(songId, dificultad)
        marcarRecienteLocal(id)
    }
    class GestorGeneros <<control>> {
        [Genre, Song, InstrumentGenre, Lesson]
        --
        obtenerDetalleGenero(id)
        cargarCarruselesCanciones(id)
        obtenerInstrumentGenres(genreId)
        cargarLeccionesItinerario(instrumentGenreId)
    }
    class GestorSpotifyAuth <<control>> {
        [SpotifyUser, User]
        --
        solicitarURLAutorizacion()
        callback(code, state)
        renovarToken(userId)
    }
    class GestorAfinaciones <<control>> {
        [Tune, Instrument]
        --
        obtenerAfinaciones()
        seleccionarPorDefecto(favoritos)
    }
    class ProcesadorAudio <<control>> {
        iniciarEscucha(notas)
        detenerEscucha()
        fijarCuerda(indice)
        extraerFrecuenciaFundamental()
        buscarCuerdaMasCercana(frecuencia)
        calcularDesviacion()
    }
    class MotorRitmo <<control>> {
        fijarBPM(bpm)
        registrarPulsacion(instante)
        iniciar()
        detener()
    }
}

' ---------------------------------------------------------------------
' Fronteras con sistemas externos
' ---------------------------------------------------------------------

package "Fronteras con sistemas externos" {
    class ServidorCorreoGateway <<boundary>>
    class NavegadorExterno <<boundary>>
    class SpotifyOAuthGateway <<boundary>>
    class Microfono <<boundary>>
}

' Frontera -> control
RegistroScreen --> GestorAutenticacion
ModalVerificacionEmail --> GestorAutenticacion
LoginScreen --> GestorAutenticacion
PerfilScreen --> GestorAutenticacion : cerrar sesión
PerfilScreen --> GestorPerfil
PerfilScreen --> GestorListas : crear lista
PerfilScreen --> GestorSpotifyAuth : vincular Spotify
CatalogoView --> GestorCatalogo
AnadirItemsScreen --> GestorCatalogo : búsqueda
AnadirItemsScreen --> GestorListas
AnadirItemsScreen --> MotorRecomendacion : "Para ti"
ListaScreen --> GestorListas
RecomendacionesView --> MotorRecomendacion
SongDetailScreen --> GestorCanciones
SongDetailScreen --> ModalAcorde : al pulsar un acorde
GenreScreen --> GestorGeneros
ItinerarioInstrumentoScreen --> GestorGeneros
LeccionScreen --> GestorCatalogo
AfinadorScreen --> GestorAfinaciones
AfinadorScreen --> ProcesadorAudio
MetronomoScreen --> MotorRitmo

' Control -> sistemas externos
GestorAutenticacion --> ServidorCorreoGateway : envía el código
GestorSpotifyAuth --> NavegadorExterno : abre la autorización
GestorSpotifyAuth --> SpotifyOAuthGateway : tokens OAuth2
ProcesadorAudio --> Microfono : permiso y bloques de audio

note top of CatalogoView
    No hay un buscador global: cada pestaña de
    exploración (Aprender, Canciones, Géneros)
    tiene su barra de búsqueda y filtra en local
    el catálogo de su tipo de ítem.
end note

note bottom of AfinadorScreen
    CU-11. El audio se analiza en el
    dispositivo (YIN): no se envía al servidor.
end note

@enduml
