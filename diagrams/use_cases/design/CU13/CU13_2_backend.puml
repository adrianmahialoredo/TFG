@startuml DSD-CU-13-2
title DSD-CU-13 (2/2) - Recuperar contraseña (backend)

' Lo que hace el backend en los tres endpoints de DSD-CU-13 (1/2).
' Fuentes: AuthController.java, EmailVerificationServiceImpl.java, EmailServiceImpl.java,
' UserServiceImpl.java, UserRepository.java, PasswordResetCodeDto.java, PasswordResetDto.java.
' Los códigos de recuperación viven en memoria en su propio mapa (resetCodes), separado de los
' del registro, con las mismas reglas (10 min, 5 intentos, 60 s entre envíos).
!include ../_estilo.iuml

participant "App\n(services)" as app
box "Backend (Spring Boot)" #FFF9F0
    participant "AuthController\n<<controller>>" as ctrl
    participant "EmailVerification\nServiceImpl\n<<service>>" as verification
    participant "UserServiceImpl\n<<service>>" as users
    participant "UserRepository\n<<repository>>" as userRepo
    participant "EmailServiceImpl\n<<service>>" as emailService
end box
participant "Servidor SMTP\n<<sistema externo>>" as smtp

note over ctrl : /api/auth/** es público (SecurityConfig).\nIllegalArgumentException -> 400; 429 con ResponseStatusException;\n@Valid: email con formato, código no vacío, newPassword\ncon la política del registro (400 con errors.campo)

group POST /api/auth/password-reset/code
    app -> ctrl : sendPasswordResetCode(@Valid dto)
    ctrl -> verification : sendPasswordResetCode(email)
    verification -> verification : ensureCooldownElapsed(resetCodes, key)
    alt Código previo de hace menos de 60 s
        verification --> ctrl : ResponseStatusException(429)
        ctrl --> app : 429 Too Many Requests
    else
        verification -> userRepo : existsByEmailIgnoreCase(key)
        alt No hay cuenta con ese email
            verification --> ctrl : void (no se envía nada)
        else Hay cuenta
            verification -> verification : issueCode(resetCodes, key, sender)\n(6 dígitos, SecureRandom)
            verification ->> emailService : sendPasswordResetCode(email, code, 10)\n(en applicationTaskExecutor)
            emailService -> smtp : plantilla password-reset (.html y .txt)
            note right of emailService : Si el envío falla se descarta\nel código (resetCodes.remove)
            verification --> ctrl : void
        end
        ctrl --> app : 204 No Content (igual en los dos casos)
    end
end

group POST /api/auth/password-reset/verify
    app -> ctrl : verifyPasswordResetCode(@Valid dto)
    ctrl -> verification : checkPasswordResetCode(email, code)
    alt Sin pedir, caducado, incorrecto o 5.º fallo
        verification --> ctrl : IllegalArgumentException(mensaje)
        ctrl --> app : 400 { message }
    else Correcto (no se consume)
        ctrl --> app : 204 No Content
    end
end

group POST /api/auth/password-reset
    app -> ctrl : resetPassword(@Valid dto)
    ctrl -> verification : checkPasswordResetCode(email, code)
    ctrl -> users : resetPassword(email, newPassword)
    users -> userRepo : findByEmailIgnoreCase(email)
    users -> users : user.setPassword(passwordEncoder.encode(newPassword))
    users -> userRepo : save(user)
    ctrl -> verification : consumePasswordResetCode(email)
    ctrl --> app : 204 No Content
    note right of app : Error del código: 400 y la contraseña no cambia
end
@enduml
