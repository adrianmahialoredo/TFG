@startuml DSD-CU-12-1
title DSD-CU-12 (1/2) - Utilizar metrónomo: apertura y ajuste del tempo (app)

' Diagrama de secuencia de diseño: realización de CU-12 (análisis en
' diagrams/use_cases/description/CU12_metronomo.puml).
' Fuentes: frontend/src/screens/MetronomeScreen.tsx, hooks/useMetronome.ts (useMetronome y
' useTapTempo), components/metronome/(MetronomeSlider, MetronomeTempoButton,
' MetronomeActionButton).tsx, navigation/BottomTabs.tsx, screens/HomeScreen.tsx.
' Solo frontend: no hay llamadas al backend ni configuración guardada.
' Diferencias con el análisis:
'  - Rango de tempo 30-300 BPM (MIN_TEMPO/MAX_TEMPO de MetronomeSlider), no 40-240; por defecto 120.
'  - No hay entidad de configuración persistida: tempo y sonido son estado (useState) de la pantalla;
'    se conservan mientras la pantalla siga montada (los tabs no se desmontan).
'  - Además del deslizador y el tap tempo, hay botones de ajuste fino (-10, -1, +1, +10).
!include ../_estilo.iuml

actor "Músico" as actor
box "App (React Native)" #F3F8FF
    participant "MetronomeScreen\n<<Nivel 7>>" as screen
    participant "MetronomeSlider\n(+ MetronomeTempoButton)\n<<Nivel 7>>" as slider
    participant "useTapTempo\n<<Nivel 6>>" as tapHook
    participant "useMetronome\n<<Nivel 6>>" as metro
end box
participant "expo-audio\n(AudioPlayer)\n<<librería>>" as audio

== Apertura ==

actor -> screen : pulsa "Metrónomo" en el Home\n(navigate('MetronomeScreen'))
screen -> screen : tempo = DEFAULT_TEMPO (120)\nsound = 'click'
screen -> metro : useMetronome(tempo, sound, handleBeat)
activate metro
metro -> audio : setAudioModeAsync({ playsInSilentMode: true,\ninterruptionMode: 'mixWithOthers' })
loop Por cada sonido (click, hihat) y variante (normal, accent)
    metro -> audio : createAudioPlayer(file)\nplayer.volume = volume * MASTER_VOLUME
end
metro -> metro : soundsRef = loaded; ready = true
note right of metro : Si falla la carga solo se registra el error:\nel pulso visual funciona igual
deactivate metro
screen -> tapHook : useTapTempo()
screen -> slider : <MetronomeSlider tempo onTempoChange={setTempo}>
slider --> actor : "Tempo  BPM 30-300", "120 BPM", -10 -1 +1 +10

== Ajuste del tempo ==

alt Deslizador
    actor -> slider : arrastra el slider
    slider -> slider : updateTempo(value) -> clampTempo(value)
    slider -> screen : onTempoChange(bpm) = setTempo(bpm)
else Botones de ajuste fino
    actor -> slider : pulsa -10 / -1 / +1 / +10 (MetronomeTempoButton)
    slider -> screen : onTempoChange(clampTempo(tempo ± n))
else 3a. Tap Tempo
    loop Por cada pulsación de "TAP TEMPO" (MetronomeActionButton)
        actor -> screen : pulsa TAP TEMPO -> handleTap()
        screen -> tapHook : tap()
        tapHook -> tapHook : now = Date.now(); si han pasado > TAP_RESET_MS (2 s)\ndesde el último: taps = []; taps.push(now),\nconserva los 5 últimos (TAP_SAMPLES + 1)
        alt Menos de 2 toques
            tapHook --> screen : null
        else
            tapHook -> tapHook : averageInterval = (último - primero) / (n - 1)
            tapHook --> screen : Math.round(60000 / averageInterval)
            screen -> screen : setTempo(clampTempo(bpm))
        end
    end
end
screen -> metro : useMetronome(tempo, ...) (re-render)
metro -> metro : tempoRef.current = tempo
note right of metro : Si está sonando, el nuevo tempo\nse aplica desde el siguiente golpe
screen -> slider : tempo
slider --> actor : muestra "<tempo> BPM"

@enduml
