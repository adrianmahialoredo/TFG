@startuml DSD-CU-12-2
title DSD-CU-12 (2/2) - Utilizar metrónomo: sonido, golpes y detención (app)

' Continuación de DSD-CU-12 (1/2). Solo frontend.
' Fuentes: frontend/src/screens/MetronomeScreen.tsx, hooks/useMetronome.ts,
' components/metronome/(MetronomePulse, MetronomeBeatIndicator, MetronomeActionButton).tsx.
' Diferencias con el análisis:
'  - No se puede elegir el compás: es fijo de 4 tiempos (BEATS_PER_BAR = 4), con el primero acentuado.
'  - El sonido solo alterna entre 'click' y 'hihat' (botón "Hi-Hat").
'  - El temporizador no es de alta precisión ni de audio: es setTimeout de JS que calcula cada golpe
'    a partir del instante teórico del anterior (Date.now()), así el retraso no se acumula.
'  - La animación no va por el estado de la pantalla: se lanza por ref (pulse / setBeat) en cada golpe.
!include ../_estilo.iuml

actor "Músico" as actor
box "App (React Native)" #F3F8FF
    participant "MetronomeScreen\n<<Nivel 7>>" as screen
    participant "MetronomePulse\n<<Nivel 7>>" as pulse
    participant "MetronomeBeatIndicator\n<<Nivel 7>>" as beats
    participant "useMetronome\n<<Nivel 6>>" as metro
end box
participant "expo-audio\n(AudioPlayer)\n<<librería>>" as audio

== Sonido ==

opt Alternar Hi-Hat
    actor -> screen : pulsa "Hi-Hat"
    screen -> screen : setSound(sound === 'hihat' ? 'click' : 'hihat')
    screen -> metro : useMetronome(..., sound, ...) -> soundRef.current = sound
end

== Inicio y bucle de golpes ==

actor -> pulse : toca el círculo central (play)
pulse -> screen : onToggle() -> handleToggle()
screen -> metro : toggle()
metro -> metro : start(): beatRef = 0;\nnextBeatAtRef = Date.now(); isPlaying = true
metro -> metro : tick()
loop Mientras timerRef no sea null (hasta que se detiene)
    metro -> metro : beatInBar = beatRef % BEATS_PER_BAR (4)
    alt beatInBar === 0
        metro ->> audio : sounds[soundRef].accent.seekTo(0).then(play())
    else
        metro ->> audio : sounds[soundRef].normal.seekTo(0).then(play())
    end
    note right of audio : No se espera a la reproducción\npara no retrasar el siguiente golpe
    metro -> screen : onBeat(beatInBar) = handleBeat(beatInBar)
    screen -> pulse : pulseRef.pulse(beatInBar)
    pulse --> actor : onda (Reanimated, mayor si es el 1.er tiempo)
    screen -> beats : beatIndicatorRef.setBeat(beatInBar)
    beats --> actor : ilumina el punto del tiempo actual
    metro -> metro : beatRef += 1\nnextBeatAtRef += 60000 / tempoRef
    metro ->> metro : timerRef = setTimeout(tick,\nmax(0, nextBeatAtRef - Date.now()))
    note right of metro : Se programa desde el instante teórico\ndel golpe anterior, no desde "ahora":\nel retraso no se acumula
end

== Detención ==

alt El músico lo detiene
    actor -> pulse : toca el círculo central (stop)
    pulse -> screen : onToggle() -> handleToggle()
    screen -> beats : setBeat(null)
    screen -> metro : toggle() -> stop()
else Sale de la pantalla (limpieza de useFocusEffect)
    actor -> screen : sale del metrónomo
    screen -> metro : stop()
    screen -> beats : setBeat(null)
end
metro -> metro : clearTimeout(timerRef); timerRef = null;\nisPlaying = false
metro --> screen : isPlaying = false
screen --> actor : "Toca para empezar"
note over metro, audio : Al desmontar el hook: clearTimeout y releaseAll(sounds)\n(player.remove() de cada AudioPlayer)

@enduml
