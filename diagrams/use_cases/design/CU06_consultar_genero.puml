@startuml DSD-CU-06
title DSD-CU-06 - Consultar espacio de género

' Diagrama de secuencia de diseño: realización de CU-06 (análisis en
' diagrams/use_cases/description/CU06_consultar_genero.puml).
' Fuentes: frontend/src/screens/GenreMainScreen.tsx, GenreDescriptionScreen.tsx, GenreSongsScreen.tsx,
' GenreInstrumentsScreen.tsx, InstrumentGenreLessonScreen.tsx, LessonScreen.tsx, components/EdgePanel.tsx,
' components/LessonSectionViewer.tsx, components/carousels/GenreLessonsCarousel.tsx; hooks/useGenreMain.ts,
' useGenreDescription.ts, useGenreSongs.ts, useGenreInstruments.ts, useInstrumentGenreLesson.ts,
' useInstrumentGenre.ts, useLesson.ts; repositories/genre, song, instrumentGenre, lesson, lessonSection,
' item .repository.ts; utils/entityCache.utils.ts; services/genre, song, instrumentGenre, lesson,
' lessonSection .service.ts; backend GenreController, SongController, InstrumentGenreController,
' LessonController, LessonSectionController, Genre/Song/InstrumentGenre/Lesson/LessonSectionServiceImpl,
' utils/EntityResolver.java, utils/mapper/DtoMapper.java, model/InstrumentGenre.java.
' Notas de diseño:
' - Para no superar ~12 líneas de vida se agrupan en una sola los hooks de cada pantalla, los
'   repositorios, las Entity Stores, los services del frontend y los *ServiceImpl del backend; cada
'   mensaje indica el objeto/clase real. Las consultas JPA se dibujan como llamada del servicio a su
'   repositorio (SongRepository, InstrumentGenreRepository...).
' - Las pestañas GenreDescriptionScreen, GenreSongsScreen y GenreInstrumentsScreen son subvistas
'   embebidas en GenreMainScreen (no rutas); InstrumentGenreLessonScreen se embebe en la pestaña
'   "Instrumentos" al elegir un instrumento.
' - El orden del itinerario (indexInInstrumentGenre) no lo calcula el cliente: lo da
'   @OrderBy("indexInInstrumentGenre ASC") en InstrumentGenre.lessons, que DtoMapper vuelca en lessonIds.
' - La selección de una lección del itinerario (6a) se hace en el EdgePanel y se muestra en la misma
'   InstrumentGenreLessonScreen (useLesson). LessonScreen (ruta propia) se usa al abrir una lección del
'   carrusel "Recomendaciones" de la pestaña Instrumentos, con el mismo useLesson.
' - useGenreMain también precarga lessonRepository.getByGenreId (GET /api/lessons/by-genre/{genreId}),
'   que ninguna pestaña pinta directamente.
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6
skinparam maxMessageSize 260
skinparam BoxPadding 10

actor "Músico" as actor

box "App (React Native)" #F3F8FF
    participant "GenreMainScreen\n(+ GenreDescriptionScreen,\nGenreSongsScreen,\nGenreInstrumentsScreen)\n<<Nivel 7>>" as screen
    participant "InstrumentGenreLessonScreen\n<<Nivel 7>>" as igScreen
    participant "useGenreMain\nuseGenreDescription\nuseGenreSongs\nuseGenreInstruments\n<<Nivel 6>>" as genreHooks
    participant "useInstrumentGenreLesson\nuseInstrumentGenre\nuseLesson\n<<Nivel 6>>" as igHooks
    participant "genreRepository\nsongRepository\ninstrumentGenreRepository\nlessonRepository\nlessonSectionRepository\nitemRepository\n<<Nivel 3>>" as repos
    participant "Entity Stores\n<<Nivel 4>>" as stores
    participant "genreService\nsongService\ninstrumentGenreService\nlessonService\nlessonSectionService\n<<Nivel 1>>" as services
end box

box "Backend (Spring Boot)" #FFF9F0
    participant "GenreController\n<<controller>>" as genreController
    participant "SongController\n<<controller>>" as songController
    participant "InstrumentGenreController\nLessonController\nLessonSectionController\n<<controller>>" as igController
    participant "GenreServiceImpl\nSongServiceImpl\nInstrumentGenreServiceImpl\nLessonServiceImpl\nLessonSectionServiceImpl\n<<service>>" as backServices
    participant "DtoMapper\n<<mapper>>" as mapper
end box

== Entrada al espacio del género ==

actor -> screen : pulsa un género (GenresScreen o navigateToItem)\nnavigate('GenreMainScreen', { genreId })
screen -> genreHooks : useGenreMain(genreId)
genreHooks -> repos : Promise.allSettled([\n genreRepository.getById(genreId),\n instrumentGenreRepository.getByGenreId(genreId),\n lessonRepository.getByGenreId(genreId) ])

group genreRepository.getById(genreId)
    repos -> stores : useGenreEntitiesStore.genres[id]
    alt en RAM o en disco (genreLocal.getById)
        stores --> repos : GenreDTO
        repos ->> services : cache.revalidate([id])\n(POST /api/genres/by-ids en segundo plano)
    else cache-miss
        repos -> services : genreService.getById(id)
        services -> genreController : GET /api/genres/{id}
        genreController -> backServices : GenreServiceImpl.findById(id)
        backServices -> backServices : EntityResolver.findGenre(id)\n-> GenreRepository.findById(id)
        backServices -> mapper : genreToGenreDto(genre)
        mapper --> backServices : GenreDTO (description, bannerUrl,\nwelcomeIntroVideoId, welcomeSongVideoId, lessonIds)
        genreController --> services : 200 OK GenreDTO\n(404 Not Found si no existe)
        services --> repos : GenreDTO
        repos -> repos : cache.markFresh([id]); genreLocal.saveBatch([genre])
    end
    repos -> stores : useGenreEntitiesStore.setGenres([genre])\n+ useItemEntitiesStore.setItems(resumen)
end

group instrumentGenreRepository.getByGenreId(genreId) : cache.list('genre_{genreId}')
    note right of repos : Cache-First: con índice guardado devuelve los IDs\nal instante y la petición sigue en segundo plano
    repos -> services : instrumentGenreService.getByGenreId(genreId)
    services -> igController : GET /api/instrument-genres/by-genre/{genreId}
    igController -> backServices : InstrumentGenreController.getForGenre(genreId)\n-> InstrumentGenreServiceImpl.findForGenre(genreId)
    backServices -> backServices : InstrumentGenreRepository.findByGenreId(genreId)
    backServices -> mapper : instrumentGenreToInstrumentGenreDto(ig)
    mapper --> backServices : InstrumentGenreDTO (instrumentId, genreId,\nlessonIds ordenados por indexInInstrumentGenre)
    igController --> services : 200 OK\nList<InstrumentGenreDTO>
    services --> repos : InstrumentGenreDTO[]
    repos -> stores : useInstrumentGenreEntitiesStore.setInstrumentGenres(igs)\n(hydrate: RAM + disco + índice)
    repos ->> repos : lessonRepository.getAllById(allLessonIds)\n(precarga: POST /api/lessons/by-ids)
end

note over repos, mapper : lessonRepository.getByGenreId(genreId): cache.list('genre_{genreId}') ->\nGET /api/lessons/by-genre/{genreId} -> LessonServiceImpl.findForGenre ->\nLessonRepository.findByGenreIdAndBelongsToGenreTrue -> 200 OK List<LessonDTO>

genreHooks ->> repos : itemRepository.markAsAccessed(genreId)
repos ->> stores : useRecentItemsStore.markAsAccessed(userId, genreId)
genreHooks --> screen : { genre, loading, error, selectedTab = 'Género' }

alt no se pudo cargar el género
    screen --> actor : "No se pudo cargar la información del género"
else
    screen -> genreHooks : useGenreDescription(genreId)
    genreHooks -> stores : useGenreEntitiesStore.genres[genreId]
    genreHooks --> screen : { description, bannerUrl, welcomeVideoId, welcomeSongId }
    screen --> actor : título, pestañas (Instrumentos, Canciones, Género),\nbanner, descripción y vídeos de bienvenida (YoutubePlayer)
end

== Pestaña "Canciones" ==

actor -> screen : pulsa "Canciones" (changeTab)
screen -> genreHooks : useGenreSongs(genreId)
par Promise.all de los tres carruseles
    genreHooks -> repos : songRepository.getPopularByGenreId(genreId, onFresh)
else
    genreHooks -> repos : songRepository.getClassicByGenreId(genreId, onFresh)
else
    genreHooks -> repos : songRepository.getNewByGenreId(genreId, onFresh)
end
loop por cada carrusel (popular | classic | new), cache.list('<tipo>_genre_{genreId}')
    repos -> services : songService.get<Tipo>ByGenreId(genreId)
    services -> songController : GET /api/songs/by-genre/{genreId}/popular|classic|new
    songController -> backServices : SongServiceImpl.findPopularForGenre |\nfindClassicForGenre | findNewForGenre(genreId)
    backServices -> backServices : SongRepository.findByGenresIdAndGenrePopularTrue |\n...GenreClassicTrue | ...GenreNewTrue(genreId)
    backServices -> mapper : songToSongDto(song)
    mapper --> backServices : SongDTO
    songController --> services : 200 OK\nList<SongDTO> (DTO completo: excepción de negocio)
    services --> repos : SongDTO[]
    repos -> stores : useSongEntitiesStore.setSongs(songs)\n+ useItemEntitiesStore.setItems(resúmenes) + índice
    repos --> genreHooks : ids (y onFresh(ids) si había caché)
end
genreHooks -> stores : useItemEntitiesStore(state => state.items)
genreHooks -> genreHooks : itemsToCarouselItems(...) por carrusel
genreHooks --> screen : { populars, classics, news }
screen --> actor : SongsCarousel "Populares", "Clásicas" y "Nuevas"
note right of actor : Al pulsar una canción se abre\nSongScreen (DSD-CU-05)

== Pestaña "Instrumentos" e itinerario ==

actor -> screen : pulsa "Instrumentos" (changeTab)
screen -> genreHooks : useGenreInstruments(genreId)
genreHooks -> stores : useInstrumentGenreEntitiesStore.instrumentGenres
genreHooks -> genreHooks : filter(ig.genreId === genreId)\n.sort(por title)
note right of genreHooks : Sin peticiones: los InstrumentGenre\nse cargaron al entrar al género
genreHooks --> screen : instrumentGenres
alt sin InstrumentGenres
    screen --> actor : "No hay instrumentos configurados para este género."
else
    screen --> actor : ToolButton por instrumento + GenreLessonsCarousel\n"Recomendaciones" (GET /api/recommendations/lessons/by-genre/{genreId})
end

actor -> screen : selecciona un instrumento
screen -> genreHooks : selectInstrument(ig.id)
screen -> igScreen : <InstrumentGenreLessonScreen\ninstrumentGenreId instrumentName onBack />
igScreen -> igHooks : useInstrumentGenreLesson(instrumentGenreId)
igHooks ->> repos : itemRepository.markAsAccessed(instrumentGenreId)
repos ->> stores : useRecentItemsStore.markAsAccessed(userId, igId)
igHooks -> repos : instrumentGenreRepository.getById(igId)
note right of repos : RAM -> disco -> GET /api/instrument-genres/{id}\n(normalmente ya en RAM)
repos --> igHooks : InstrumentGenreDTO
igHooks -> repos : lessonRepository.getAllById(lessonIds)
opt faltan lecciones en caché
    repos -> services : lessonService.getAllById(missing)
    services -> igController : POST /api/lessons/by-ids\n[ids]
    igController -> backServices : LessonController.getByIds(ids)\n-> LessonServiceImpl.findByIds(ids)\n-> LessonRepository.findAllById(ids)
    backServices -> mapper : lessonToLessonDto(lesson)
    mapper --> backServices : LessonDTO (sectionIds, indexInInstrumentGenre...)
    igController --> services : 200 OK\nList<LessonDTO>
    services --> repos : LessonDTO[]
    repos -> stores : useLessonEntitiesStore.setLessons(lessons)
end
igHooks -> stores : lessons[id] en el orden de instrumentGenre.lessonIds
igHooks -> igHooks : activeLesson = la primera lección

group useLesson(activeLesson.id, { markAccessed: false })
    igHooks -> repos : lessonRepository.getById(lessonId)
    note right of repos : RAM -> disco -> GET /api/lessons/{id}\n(LessonController.getById -> LessonServiceImpl.findById)
    repos -> repos : lessonSectionRepository.getAllById(lesson.sectionIds)
    opt faltan secciones en caché
        repos -> services : lessonSectionService.getAllById(missing)
        services -> igController : POST /api/lesson-sections/by-ids\n[ids]
        igController -> backServices : LessonSectionController.getByIds(ids)\n-> LessonSectionServiceImpl.findByIds(ids)
        backServices -> mapper : lessonSectionToLessonSectionDto(section)
        mapper --> backServices : LessonSectionDTO (title, htmlContent,\nvideoUrl, orderIndex)
        igController --> services : 200 OK\nList<LessonSectionDTO>
        services --> repos : LessonSectionDTO[]
        repos -> stores : useLessonSectionEntitiesStore.setLessonSections(sections)
    end
    repos --> igHooks : LessonDTO
    opt la lección pertenece a un género (lesson.genreId)
        igHooks -> repos : genreRepository.getById(genreId)
    end
    igHooks -> igHooks : sections ordenadas por orderIndex;\ncurrentSection = sections[0]
end
igHooks --> igScreen : { instrumentGenre, lessons, activeLesson,\nsections, currentSection, goToNext, goToPrevious }

alt el itinerario no tiene lecciones
    igScreen --> actor : "Este itinerario aún no tiene lecciones"
else
    igScreen --> actor : lección activa (imagen, título, DifficultyStars),\nLessonSectionViewer (YoutubeVideo + HTML de la sección)\ny EdgePanel con el itinerario
end

opt 6a. El músico selecciona una lección del itinerario
    actor -> igScreen : elige una lección en el EdgePanel
    igScreen -> igHooks : setActiveLessonId(id)
    igHooks -> repos : useLesson(id) -> lessonRepository.getById(id)\n(+ lessonSectionRepository.getAllById(sectionIds))
    repos --> igHooks : LessonDTO (secciones en la Entity Store)
    igHooks --> igScreen : nueva activeLesson, sections (por orderIndex),\ncurrentSection = primera
    igScreen --> actor : muestra la lección con sus secciones
    loop navega entre secciones
        actor -> igScreen : pulsa siguiente / anterior
        igScreen -> igHooks : goToNext() / goToPrevious()
        igHooks --> igScreen : currentSection
        igScreen --> actor : vídeo de YouTube (si tiene) y contenido HTML
    end
end

@enduml
