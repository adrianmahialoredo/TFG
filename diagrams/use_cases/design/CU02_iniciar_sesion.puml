@startuml DSD-CU-02
title DSD-CU-02 - Iniciar sesión

' Diagrama de secuencia de diseño: realización de CU-02 (análisis en
' diagrams/use_cases/description/CU02_iniciar_sesion.puml).
' Fuentes: frontend/src/screens/LoginScreen.tsx, context/AuthContext.tsx,
' repositories/auth.repository.ts, repositories/item.repository.ts, repositories/genre.repository.ts,
' services/auth.service.ts, services/item.service.ts, services/apiClient.ts,
' stores/entities/auth.entities.store.ts, stores/entities/user.entities.store.ts,
' utils/entityCache.utils.ts, navigation/AppNavigator.tsx, config/apiConfig.ts;
' AuthController.java, LoginRequestDto.java, LoginResponse.java, UserServiceImpl.java,
' UserRepository.java, JwtUtil.java, GlobalExceptionHandler.java, SecurityConfig.java, ItemController.java.
' Diferencias con el guion:
' - LoginScreen no llama a authRepository: llama a login() de AuthContext (useAuth), que es
'   quien llama a authRepository.login(identifier, password).
' - El body es { identifier, password } (no { email, pass }); `email` solo se acepta como alias.
' - No hay AuthService en el backend: AuthController delega en UserServiceImpl.login, que busca
'   por email y, si no hay nadie, por username (UserRepository.findByEmail / findByUsername).
' - La respuesta es LoginResponse { token, user: UserResponseDTO }.
' - authRepository guarda el usuario en useUserEntitiesStore y en disco con userLocal.saveBatch
'   y llama a useAuthStore.setAuth(token, userId); la AuthStore se persiste sola (persist de
'   Zustand), no con AsyncStorage.multiSet.
' - La precarga del catálogo no la lanza authRepository: la lanza el efecto de AuthProvider
'   (loadInitialData) al cambiar el token: itemRepository.getCatalog() en segundo plano
'   (GET /api/items) y, esperando, genreRepository.getAll() (GET /api/genres).
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6
skinparam maxMessageSize 260
skinparam BoxPadding 10

actor "Visitante" as actor

box "App (React Native)" #F3F8FF
    participant "LoginScreen\n<<Nivel 7>>" as screen
    participant "AuthProvider\n(useAuth)\n<<Nivel 6>>" as context
    participant "authRepository\n<<Nivel 3>>" as repo
    participant "itemRepository\n<<Nivel 3>>" as itemRepo
    participant "authService\n<<Nivel 1>>" as service
    participant "useUserEntitiesStore\nuseAuthStore\n<<Nivel 4>>" as store
end box

box "Backend (Spring Boot)" #FFF9F0
    participant "AuthController\n<<controller>>" as controller
    participant "UserServiceImpl\n<<service>>" as userService
    participant "UserRepository\n<<repository>>" as userRepo
    participant "JwtUtil\n<<security>>" as jwt
end box

actor -> screen : introduce email o usuario y contraseña
actor -> screen : pulsa "Iniciar Sesión"
screen -> screen : handleLogin() -> validateForm()

alt Campo vacío
    screen --> actor : showAlert('Por favor ingresa tu email o tu usuario' |\n'Por favor ingresa tu contrasena')
else Formulario completo
    screen -> context : login(identifier, password)
    context -> repo : login(identifier, password)
    repo -> service : login(identifier, password)
    service -> controller : POST /api/auth/login\n{ identifier: identifier.trim(), password }
    note right of service : apiClient no añade JWT (aún no hay token)\ny /api/auth/** es público (SecurityConfig)
    controller -> userService : login(dto.getIdentifier(), dto.getPassword())
    userService -> userRepo : findByEmail(login)
    userRepo --> userService : Optional<User>
    opt No hay ningún usuario con ese email
        userService -> userRepo : findByUsername(login)
        userRepo --> userService : Optional<User>
    end

    alt Usuario inexistente o contraseña errónea
        userService -> userService : passwordEncoder.matches(password, hash)\n(solo si hay usuario)
        userService --> controller : BadCredentialsException("Invalid credentials")
        controller --> service : 401 Unauthorized\n{ message } (GlobalExceptionHandler)
        service --> repo : AuthServiceError("Usuario, email o contraseña incorrectos", 401)
        repo --> context : throw
        context --> screen : throw
        screen --> actor : showAlert({ title: 'Error de Inicio de Sesion', message })
    else Credenciales válidas
        userService -> userService : passwordEncoder.matches(password, hash) : true
        userService -> jwt : generateToken(user.getId(), user.getRole())
        jwt --> userService : token (subject = id, claim role)
        userService --> controller : LoginResponse(token,\ndtoMapper.userToUserResponseDto(user))
        controller --> service : 200 OK\nLoginResponse { token, user }
        service --> repo : { token, user }
        repo -> store : useUserEntitiesStore.setUsers([user])
        repo -> repo : userLocal.saveBatch([user])
        note right of repo : Disco (AsyncStorage)
        repo -> store : useAuthStore.setAuth(token, userId)
        note right of store : AuthStore persistida ('auth-store'):\nsolo token y currentUserId.\nDesde aquí apiClient añade\nAuthorization: Bearer <token>
        repo --> context : { token, user }
        context --> screen : void
        screen -> screen : navigation.reset({ routes: [BottomTab] })
        screen --> actor : pantalla principal (BottomTab)

        == Precarga de datos globales (efecto de AuthProvider) ==

        store ->> context : token cambia (selector de useAuthStore)
        context -> context : useEffect -> initializeAuth()\n(initialDataLoadedRef = true)
        context -> context : loadInitialData()
        context ->> itemRepo : getCatalog()
        note right of itemRepo : Segundo plano (no se espera).\ncache.list('items_catalog', itemService.getAll):\nsi hay índice en disco devuelve sus IDs al instante;\nla red (GET /api/items -> ItemController.getAll ->\n200 OK List<ItemSummaryDTO>) se consulta una vez\npor sesión e hidrata useItemEntitiesStore + disco
        context -> context : await genreRepository.getAll()
        note right of context : GET /api/genres (cache.list('all', ...))
    end
end

@enduml
