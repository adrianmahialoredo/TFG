@startuml DSD-CU-07-4
title DSD-CU-07 (4/6) - Gestionar listas de estudio: eliminar lista (app)

' Fuentes: frontend/src/screens/ListScreen.tsx, hooks/useItemListDetail.ts,
' repositories/itemList.repository.ts, services/itemList.service.ts, local/itemList.local.ts.
' Backend en DSD-CU-07 (5/6 y 6/6). itemListService (Nivel 1) no tiene línea de vida: la flecha
' a la API es su llamada.
' - La lista se purga de RAM y disco solo si el backend confirma el borrado (204).
!include ../_estilo.iuml

actor "Músico" as actor
box "App (React Native)" #F3F8FF
    participant "ListScreen\n<<Nivel 7>>" as listScreen
    participant "useItemList\nDetail\n<<Nivel 6>>" as useDetail
    participant "itemList\nRepository\n<<Nivel 3>>" as repo
    participant "useItemList\nEntitiesStore\n<<Nivel 4>>" as store
end box
participant "API REST" as api

actor -> listScreen : pulsa "Eliminar lista"
listScreen --> actor : showAlert("Eliminar lista", confirmación)
alt Cancela
    actor -> listScreen : Cancelar
else Confirma
    actor -> listScreen : Eliminar
    listScreen -> useDetail : deleteList()
    useDetail -> repo : deleteItemList(listId)
    repo -> repo : userId de la lista (RAM o disco)
    repo -> api : itemListService\n.deleteItemList(\nlistId): DELETE /api/item-lists/{id}
    alt Eliminada
        api --> repo : 204 No Content
        repo -> store : removeItemLists(\n[listId])
        repo -> repo : itemListLocal\n.removeById(listId, userId)
        repo --> useDetail : true
        useDetail --> listScreen : true
        listScreen -> listScreen : navigation.goBack()
        listScreen --> actor : vuelve a Perfil; la lista ya no aparece
    else Error (404 no existe, 403 no es tuya, sin red)
        api --> repo : 404 / 403 / error de red (throw)
        repo --> useDetail : false
        useDetail --> listScreen : false
        listScreen --> actor : "No se pudo eliminar la lista"
    end
end

@enduml
