@startuml DSD-CU-09-6
title DSD-CU-09 (6/8) - Consultar recomendaciones: backend de artistas favoritos

' Lo que hace el backend en las peticiones de DSD-CU-09 (5/8).
' Fuentes: UserController.java, UserServiceImpl.java, model/User.java, SongController.java,
' SongServiceImpl.java, repository/SongRepository.java, utils/RecommendationConstants.java,
' security/OwnershipChecker.java, GlobalExceptionHandler.java.
' - Los artistas favoritos son los que más se repiten en las canciones de las listas del usuario
'   (User.getTopArtistsFromItemLists); no se guardan en ningún sitio.
' - Límites (RecommendationConstants): total_artists entre 1 y MAX_N_TOP_ARTISTS = 10 (por defecto
'   DEFAULT_N_TOP_ARTISTS = 5); limit entre 1 y MAX_N_SONGS_BY_ARTISTS = 50 (por defecto
'   DEFAULT_N_SONGS_BY_ARTISTS = 10); hasta MAX_N_ARTISTS_IN_SONGS_BY_ARTISTS = 10 artistas (artist1..artist10).
'   Fuera de rango: IllegalArgumentException -> 400.
!include ../_estilo.iuml

participant "App\n(services)" as app
box "Backend (Spring Boot)" #FFF9F0
    participant "UserController /\nSongController" as ctrl
    participant "UserServiceImpl /\nSongServiceImpl" as svc
    participant "User\n<<entity>>" as user
    participant "SongRepository /\nEntityResolver" as repo
end box
database "PostgreSQL" as db

group GET /api/users/{id}/top-artists?total_artists=5
    app -> ctrl : UserController.getTopArtistsForUser(id, 5)
    note right of ctrl : @PreAuthorize(hasRole('ADMIN') or\n@ownership.isSelf(#id)). Otro usuario: 403
    ctrl -> svc : UserServiceImpl.findTopArtistsForUser(id, 5)
    svc -> repo : EntityResolver.findUser(id)
    repo -> db : SELECT
    alt El usuario no existe
        svc --> ctrl : Optional.empty()
        ctrl --> app : 404 Not Found (ResponseEntity.of)
    else Existe
        svc -> user : getTopArtistsFromItemLists(5)
        note right of user : Cuenta los artistas de las canciones\nde todas sus listas (LinkedHashMap +\norden estable por apariciones)
        user --> svc : List<String> artistas ([] si no hay canciones)
        svc --> ctrl : Optional<List<String>>
        ctrl --> app : 200 OK [artistas]
    end
end

group GET /api/songs/by-artists/new | popular?limit=12&artist1=..&artist2=..
    app -> ctrl : SongController.getNew | getPopularForArtists(limit, params)
    ctrl -> svc : findNew | findPopularForArtists(artistsFrom(params), 12)
    loop Por cada artista
        svc -> repo : findByArtistIgnoreCaseAndArtist{New|Popular}TrueAndIdNotIn(\nartista, idsToExclude(Set.of()), Pageable(12))
        repo -> db : SELECT
        repo --> svc : canciones del artista
    end
    svc -> svc : intercalar por turnos en un LinkedHashSet hasta 12
    note right of svc : Una de cada artista por vuelta, en el orden\nrecibido (el más repetido primero). Si uno se\nqueda sin canciones, los demás completan
    svc -> svc : DtoMapper.songToSongDto(song)
    svc --> ctrl : List<SongDTO>
    ctrl --> app : 200 OK List<SongDTO>
end

@enduml
