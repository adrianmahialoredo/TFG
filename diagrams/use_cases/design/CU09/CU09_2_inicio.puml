@startuml DSD-CU-09-2
title DSD-CU-09 (2/8) - Consultar recomendaciones: carrusel "Para ti" del Inicio (app)

' Fuentes: frontend/src/screens/HomeScreen.tsx, hooks/useHomeItems.ts, hooks/useUserTasteKey.ts,
' repositories/itemFeed.repository.ts, utils/entityCache.utils.ts, services/item.service.ts.
' El endpoint está en DSD-CU-09 (4/8).
' - Índice 'items_recommended_user' (personalizado: se borra en el logout).
' - Se vuelve a pedir cuando cambian las listas, los favoritos o el nivel del usuario (tasteKey).
' - Como en (1/8), cacheFirst captura el error: el setError("Error al sincronizar el inicio") de
'   useHomeItems no llega a ejecutarse por un fallo de la red.
!include ../_estilo.iuml

actor "Músico" as actor
box "App (React Native)" #F3F8FF
    participant "HomeScreen\n<<Nivel 7>>" as screen
    participant "useHomeItems\n<<Nivel 6>>" as hook
    participant "itemFeedRepository\n<<Nivel 3>>" as feedRepo
    participant "Entity Stores\n<<Nivel 4>>" as stores
    participant "itemService\n<<Nivel 1>>" as service
end box
participant "API REST\n(backend)" as api

actor -> screen : abre Inicio
screen -> hook : useHomeItems()
note right of hook : useEffect([currentUserId, tasteKey])
hook -> feedRepo : getRecommendedForUser(userId, setSection('recommendations'))
feedRepo -> feedRepo : getMixedFeed('items_recommended_user')\n-> cacheFirst
alt Hay índice guardado
    feedRepo --> hook : ids de la caché; después onFresh(ids)
else Sin caché
    feedRepo -> service : getRecommendedByUser(userId)
    service -> api : GET /api/recommendations/items/by-user/{id}
    alt Éxito
        api --> service : 200 List<ItemDTO> (DTOs completos, barajados)
        service --> feedRepo : AnyItemDTO[]
        feedRepo -> stores : hydrateMixed(dtos) + saveQueryIndex
        feedRepo --> hook : ids
    else Error (sin red, 401, 403, 404)
        api --> service : error
        feedRepo -> feedRepo : cacheFirst captura el error
        feedRepo --> hook : []
    end
end
hook -> stores : items (suscripción Zustand)
hook -> hook : recommendations = itemsToCarouselItems(ids)
hook --> screen : recommendations
alt Hay recomendaciones
    screen --> actor : carrusel "Para ti"
else Vacío
    screen --> actor : "Explora la app y empieza a aprender\npara que se muestren tus recomendaciones"
end

@enduml
