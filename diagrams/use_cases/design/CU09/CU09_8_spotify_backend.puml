@startuml DSD-CU-09-8
title DSD-CU-09 (8/8) - Consultar recomendaciones: backend de "Basado en tu Spotify"

' GET /api/spotify/recommendations/items/{userId}, pedido desde DSD-CU-09 (7/8).
' Fuentes: SpotifyRecommendationController.java, SpotifyRecommendationServiceImpl.java,
' SpotifyAuthServiceImpl.java, model/User.java, repository/SongRepository.java, LessonRepository.java,
' InstrumentGenreRepository.java, utils/RecommendationConstants.java, utils/Utils.java, GlobalExceptionHandler.java.
' - Cantidades (RecommendationConstants): N_SPOTIFY_RECOMMENDED_SONGS = 6, _LESSONS = 3,
'   _INSTRUMENT_GENRES = 2, _GENRES = 1; los instrument-genres cruzan los 5 géneros y los 5 instrumentos
'   más repetidos en las canciones (N_TOP_*_USED_IN_SPOTIFY_INSTRUMENT_GENRE_RECOMMENDATION); los artistas
'   top son N_TOP_ARTISTS_USED_IN_SPOTIFY_SONG_RECOMMENDATION = 5.
' - Nunca se recomienda lo que el usuario ya tiene en N_ITEM_LISTS_TO_EXCLUDE_FROM_RECOMMENDATIONS (3)
'   o más listas (User.getIdsExcludedFromRecommendationsOfType).
' - Errores: sin cuenta vinculada, EntityNotFoundException -> 404; si falla la renovación del token
'   (permisos revocados o Spotify caído), IllegalStateException -> 500.
!include ../_estilo.iuml

participant "App\n(services)" as app
box "Backend (Spring Boot)" #FFF9F0
    participant "SpotifyRecommendation\nController" as controller
    participant "SpotifyRecommendation\nServiceImpl" as spotifyService
    participant "SpotifyAuth\nServiceImpl" as authService
    participant "User\n<<entity>>" as user
    participant "Song / Lesson /\nInstrumentGenre\nRepository" as repos
end box
participant "Spotify Web API\n<<sistema externo>>" as spotify

app -> controller : GET /api/spotify/recommendations/items/{userId}
note right of controller : @PreAuthorize(hasRole('ADMIN') or\n@ownership.isSelf(#userId)). Otro: 403
controller -> spotifyService : findItemsForUser(userId)

group findSongEntitiesForUser(userId, 6)
    spotifyService -> authService : getValidAccessToken(userId)
    alt Sin cuenta de Spotify vinculada
        authService --> controller : EntityNotFoundException -> 404
    else Token caducado (o a menos de 1 min)
        authService -> spotify : POST accounts.spotify.com/api/token\n(grant_type=refresh_token)
        note right of authService : Si Spotify lo rechaza o no responde:\nIllegalStateException -> 500
        authService -> authService : guarda el nuevo token
    end
    authService --> spotifyService : accessToken
    spotifyService -> user : getIdsExcludedFromRecommendationsOfType(Song.class)
    spotifyService -> spotify : GET /v1/me/top/tracks: medium_term 6,\nlong_term 3, short_term 3
    spotify --> spotifyService : canciones top (título, artista)
    spotifyService -> repos : SongRepository.findByTitleAndArtistIn(candidatos)
    repos --> spotifyService : canciones de la app (sin orden)
    spotifyService -> spotifyService : orden de Spotify, sin las que están en 3 o más\nlistas, distinct(), limit(6)
    opt Faltan canciones hasta 6
        spotifyService -> spotify : GET /v1/me/top/artists?limit=5&time_range=medium_term
        spotify --> spotifyService : artistas top
        loop Por artista (el primero se queda con el resto del reparto)
            spotifyService -> repos : findByArtistIgnoreCaseAndArtist{Popular,\nClassic,New}TrueAndIdNotIn(...) en ese orden
        end
    end
end

alt 14a. Ninguna canción de Spotify está en la app
    spotifyService --> controller : List.of()
    controller --> app : 200 OK []
else Hay canciones
    spotifyService -> spotifyService : géneros e instrumentos de las canciones (con repetidos)\ntopGenres = getTopNMostRepeated(géneros)
    opt Las canciones tienen géneros
        spotifyService -> repos : findByGenreIdInAndBelongsToGenreTrueAndIdNotIn(idsOf(topGenres),\nidsToExclude(user.getIdsExcludedFromRecommendationsOfType(Lesson.class)), Pageable(3))
        opt Las canciones tienen instrumentos
            spotifyService -> repos : findByGenreIdInAndInstrumentIdInAndIdNotIn(5 géneros top, 5 instrumentos top,\nidsToExclude(user.getIdsExcludedFromRecommendationsOfType(InstrumentGenre.class)), Pageable(2))
        end
        spotifyService -> spotifyService : el género más repetido que no esté en 3 o más\nde sus listas (ya cargado: sin consulta)
    end
    spotifyService -> spotifyService : LinkedHashSet + Collections.shuffle
    spotifyService -> spotifyService : dtoMapper.itemsToItemDTOs(...)
    spotifyService --> controller : List<ItemDTO>
    controller --> app : 200 OK [SongDTO, LessonDTO,\nInstrumentGenreDTO, GenreDTO...]
end

@enduml
