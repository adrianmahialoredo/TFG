@startuml DSD-CU-09-9
title DSD-CU-09 (9/12) - Recomendaciones:\nbackend de canciones por artistas

' GET /api/songs/by-artists/new | popular?limit=12&artist1=..&artist2=.., pedido desde
' DSD-CU-09 (6/12).
' Fuentes: SongController.java, SongServiceImpl.java, repository/SongRepository.java,
' utils/RecommendationConstants.java, utils/mapper/DtoMapper.java, GlobalExceptionHandler.java.
' - limit entre 1 y MAX_N_SONGS_BY_ARTISTS = 50 (por defecto DEFAULT_N_SONGS_BY_ARTISTS = 10);
'   hasta MAX_N_ARTISTS_IN_SONGS_BY_ARTISTS = 10 artistas (artist1..artist10). Fuera de rango:
'   IllegalArgumentException -> 400.
' - Consulta por artista: findByArtistIgnoreCaseAndArtist{New|Popular}TrueAndIdNotIn(artista,
'   idsToExclude(Set.of()), Pageable(12)).
' - Se intercalan por turnos en un LinkedHashSet hasta 12: una de cada artista por vuelta, en el
'   orden recibido (el más repetido primero). Si uno se queda sin canciones, los demás completan.
!include ../_estilo.iuml

participant "App" as app
box "Backend" #FFF9F0
    participant "Song\nController" as ctrl
    participant "Song\nServiceImpl" as svc
    participant "Song\nRepository" as repo
end box
database "Postgre\nSQL" as db

app -> ctrl : getNew | getPopular\nForArtists(limit,\nparams)
ctrl -> svc : findNew | findPopular\nForArtists(artistas, 12)
loop Por cada artista
    svc -> repo : findByArtist...\nAndArtist{New|\nPopular}True\nAndIdNotIn(...)
    repo -> db : SELECT
    repo --> svc : canciones\ndel artista
end
svc -> svc : intercala por\nturnos hasta 12
svc -> svc : DtoMapper\n.songToSongDto
svc --> ctrl : List<SongDTO>
ctrl --> app : 200 OK\nList<SongDTO>

@enduml
