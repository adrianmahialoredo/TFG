@startuml DSD-CU-08
title DSD-CU-08 - Añadir/eliminar ítems en listas

' Diagrama de secuencia de diseño: realización de CU-08 (análisis en
' diagrams/use_cases/description/CU08_items_en_listas.puml).
' Fuentes: frontend/src/screens/ListScreen.tsx, screens/AddItemScreen.tsx, hooks/useAddItemScreen.ts,
' hooks/useItemListDetail.ts, repositories/itemList.repository.ts, repositories/itemFeed.repository.ts,
' repositories/item.repository.ts, services/itemList.service.ts, config/apiConfig.ts;
' JwtAuthenticationFilter.java, SecurityConfig.java, ItemListController.java, OwnershipChecker.java,
' ItemListServiceImpl.java, EntityResolver.java, model/ItemList.java, DtoMapper.java, GlobalExceptionHandler.java.
' Diferencias con el guion:
' - No existe "ItemDetailScreen": se añade desde AddItemScreen (hook useAddItemScreen) y se quita desde
'   ListScreen (hook useItemListDetail). La petición la hace itemListService (Nivel 1) sobre apiClient.
' - La regla es @PreAuthorize("hasRole('ADMIN') or @ownership.ownsItemList(#listId, authentication)"),
'   no "@ownershipChecker.isItemListOwner". Una lista inexistente pasa la comprobación y acaba en 404.
' - ItemListServiceImpl.addItem no usa resolveItemList: usa EntityResolver.findItemList(listId) y el
'   controlador responde con ResponseEntity.of(...): 200 OK + ItemListDTO, o 404 si la lista no existe.
'   Un itemId inexistente: resolveItem lanza EntityNotFoundException -> 404.
' - Quitar no usa ItemList.removeItem ni resolveItem: hace list.getItems().removeIf(id == itemId).
'   Responde 200 OK + ItemListDTO (no 204).
' - El token inválido no lo rechaza el filtro: lo deja sin autenticar y SecurityConfig responde 401.
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6
skinparam maxMessageSize 260
skinparam BoxPadding 10

actor "Músico" as actor

box "App (React Native)" #F3F8FF
    participant "ListScreen\n<<Nivel 7>>" as listScreen
    participant "AddItemScreen\n<<Nivel 7>>" as addScreen
    participant "useAddItemScreen\n<<Nivel 6>>" as addHook
    participant "useItemListDetail\n<<Nivel 6>>" as detailHook
    participant "itemListRepository\n<<Nivel 3>>" as repo
    participant "itemListService\n<<Nivel 1>>" as service
end box

box "Backend (Spring Boot)" #FFF9F0
    participant "JwtAuthenticationFilter\n<<security>>" as filter
    participant "ItemListController\n<<controller>>" as controller
    participant "ItemListServiceImpl\n<<service>>" as listService
    participant "ItemList\n<<entity>>" as itemList
    participant "ItemListRepository\n<<repository>>" as listRepo
end box

== Abrir la pantalla de añadir ==

actor -> listScreen : pulsa "Añadir"
listScreen -> addScreen : navigate('AddItemScreen', { itemListId })
addScreen -> addHook : useAddItemScreen(itemListId)
addHook -> addHook : itemFeedRepository.getRecommendedByItemList(itemListId, onFresh)
note right of addHook : "Para ti": GET /api/recommendations/items/by-item-list/{id}\n(ver DSD-CU-09)
addHook -> addHook : itemRepository.getCatalog(apply)
note right of addHook : Resumen de todos los items, normalmente\nya en RAM desde el arranque (ver CU-04)
addHook -> addHook : useMemo: oculta los que ya están en la lista\n(listItemIds de useItemListEntitiesStore)\ny se queda con los VISIBLE_RECOMMENDATIONS (5) primeros
addHook --> addScreen : items, loading, error
addScreen --> actor : muestra 5 recomendaciones "Para ti"\n(el resto, en espera)

opt 3a. Busca un ítem concreto
    actor -> addScreen : escribe en el buscador
    addScreen -> addHook : setQuery(query)
    addHook -> addHook : useMemo: filtra catalogIds en local\n(título y artista, sin tildes; máx. 50)
    note right of addHook : Sin llamar al backend
    addHook --> addScreen : items (resultados sin los ya añadidos)
    addScreen --> actor : muestra los resultados
end

== Añadir un ítem ==

actor -> addScreen : pulsa "+" en un ítem
addScreen -> addHook : addItem(itemId)
addHook -> addHook : setAddedIds([..., itemId])\nsetTimeout(dismiss, 600 ms)
addHook --> addScreen : isAdded(itemId) = true
addScreen --> actor : tic inmediato; a los 600 ms el ítem desaparece\ny entra la siguiente recomendación en espera
note right of addScreen : Respuesta optimista

addHook -> repo : addItemToList(listId, itemId)
repo -> service : addItemToList(listId, itemId)
service -> filter : POST /api/item-lists/{listId}/items/{itemId}\nAuthorization: Bearer <JWT>
filter -> filter : doFilterInternal(): jwtUtil.extractUserId(token),\nvalidateToken(token, userId), extractRole(token)

alt Token ausente o inválido
    filter --> service : 401 Unauthorized (SecurityConfig)
else Token válido
    filter -> filter : SecurityContextHolder.setAuthentication(\nuserId, ROLE_<rol>)
    filter -> controller : addItem(listId, itemId)
    controller -> controller : @PreAuthorize: OwnershipChecker.ownsItemList(listId, authentication)
    alt 6a. La lista es de otro usuario
        controller --> service : 403 Forbidden\n(AccessDeniedException -> GlobalExceptionHandler)
    else Es el propietario (o la lista no existe)
        controller -> listService : addItem(listId, itemId)
        note right of listService : @Transactional
        listService -> listService : EntityResolver.findItemList(listId)
        alt La lista no existe
            listService --> controller : Optional.empty()
            controller --> service : 404 Not Found
        else La lista existe
            listService -> listService : EntityResolver.resolveItem(itemId)
            note right of listService : Subtipo polimórfico (Song, Lesson,\nGenre, InstrumentGenre); si no existe:\nEntityNotFoundException -> 404
            listService -> itemList : addItem(item)
            alt 7a. El ítem ya estaba en la lista
                itemList --> listService : false (se ignora, conserva su posición)
            else Ítem nuevo
                itemList -> itemList : items.add(item) (al final)
                itemList --> listService : true
            end
            listService -> listRepo : save(list)
            listRepo --> listService : ItemList
            listService -> listService : DtoMapper.itemListToItemListDto(list)
            listService --> controller : Optional<ItemListDTO>
            controller --> service : 200 OK\nItemListDTO
            service --> repo : ItemListDTO (toAppItemListDTO)
            repo -> repo : hydrateItemLists([updated])
            note right of repo : useItemListEntitiesStore.setItemLists +\ncache.markFresh + itemListLocal.saveBatchWithUserIndex\n(RAM y disco)
            repo --> addHook : updated
        end
    end
end

opt 8a. La petición falla (401, 403, 404, sin red): el repositorio devuelve null
    addHook -> addHook : clearTimeout(timer)\nquita itemId de addedIds y dismissedIds
    addHook -> addHook : setError("No se pudo añadir el item a la lista")
    addHook --> addScreen : error
    addScreen --> actor : el ítem vuelve a aparecer con "+" y se muestra el error
end

actor -> addScreen : vuelve atrás
addScreen -> listScreen : navigation.goBack()
listScreen -> detailHook : refresh() (useFocusEffect)
detailHook -> repo : getItemListWithItems(itemListId)
note right of repo : Lista desde RAM (ya actualizada) e items que falten:\nitemRepository.getAllById(itemIds)
repo --> detailHook : itemIds
detailHook --> listScreen : list, items
listScreen --> actor : muestra la lista actualizada

== 1a. Quitar un ítem de la lista ==

actor -> listScreen : pulsa quitar en un ítem
listScreen -> listScreen : handleRemoveItem(item)
listScreen --> actor : showAlert("Quitar de la lista", confirmación)

alt El músico cancela
    actor -> listScreen : Cancelar
else El músico confirma
    actor -> listScreen : Quitar
    listScreen -> detailHook : removeItem(item.id)
    detailHook -> repo : removeItemFromList(listId, itemId)
    repo -> service : removeItemFromList(listId, itemId)
    service -> filter : DELETE /api/item-lists/{listId}/items/{itemId}\nAuthorization: Bearer <JWT>
    filter -> controller : removeItem(listId, itemId)
    controller -> controller : @PreAuthorize: OwnershipChecker.ownsItemList(listId, authentication)
    controller -> listService : removeItem(listId, itemId)
    listService -> listService : EntityResolver.findItemList(listId)
    alt Error: sin red, 401, 403 o lista inexistente (404)
        service --> repo : error
        repo --> detailHook : null
        detailHook --> listScreen : throw Error
        listScreen --> actor : showAlert("No se pudo quitar el item de la lista")
    else Éxito
        listService -> itemList : getItems().removeIf(item.getId().equals(itemId))
        listService -> listRepo : save(list)
        listRepo --> listService : ItemList
        listService -> listService : DtoMapper.itemListToItemListDto(list)
        listService --> controller : Optional<ItemListDTO>
        controller --> service : 200 OK\nItemListDTO
        service --> repo : ItemListDTO
        repo -> repo : hydrateItemLists([updated])
        note right of repo : RAM y disco
        repo --> detailHook : updated
        detailHook --> listScreen : items (derivados de la Store)
        listScreen --> actor : la lista se refresca sin el ítem
    end
end

@enduml
