@startuml DSD-CU-03-2
title DSD-CU-03 (2/3) - Configurar perfil: favoritos y cierre de sesión (app)

' Fuentes: screens/ProfileScreen.tsx, components/FavoritesPickerModal.tsx, hooks/useProfile.ts,
' context/AuthContext.tsx, repositories/user.repository.ts, auth.repository.ts,
' services/user.service.ts, stores/entities/*.store.ts, local/user, itemList, item, song,
' lesson .local.ts. Backend en DSD-CU-03 (3/3).
' Los favoritos se cambian con POST/DELETE /api/users/{id}/favorite-genres/{genreId}
' (e instrumentos), uno por cambio. El cierre de sesión es solo local: no hay petición al backend.
!include ../_estilo.iuml

actor "Músico" as actor
box "App (React Native)" #F3F8FF
    participant "ProfileScreen\n<<Nivel 7>>" as screen
    participant "useProfile\nAuthProvider (useAuth)\n<<Nivel 6>>" as hook
    participant "user / auth\nRepository\n<<Nivel 3>>" as repo
    participant "useUserEntitiesStore\nuseAuthStore\nuseItemListEntitiesStore\n<<Nivel 4>>" as store
    participant "userLocal, itemListLocal,\nitemLocal, songLocal,\nlessonLocal <<Nivel 2>>" as local
    participant "userService\n<<Nivel 1>>" as service
end box
participant "API REST\n(backend)" as api

== Cambiar géneros o instrumentos favoritos ==

actor -> screen : elige favoritos en FavoritesPickerModal
screen -> hook : handleSaveFavorites(ids) -> useProfile.\nupdateFavoriteGenres(ids) | updateFavoriteInstruments(ids)
hook -> repo : userRepository.updateFavorites(currentUserId, kind, ids)
repo -> repo : diff con los actuales (toAdd, toRemove)\n(sin cambios: devuelve el usuario)
repo -> store : updateUser(userId, { favouriteGenresIds: ids })
loop Por cada id añadido y después cada id quitado (en serie)
    repo -> service : addFavoriteGenre(userId, genreId)\n| removeFavoriteGenre(...)
    service -> api : POST | DELETE /api/users/{id}/\nfavorite-genres/{genreId}\n(o favorite-instruments/{instrumentId})
    api --> service : 200 UserDto
    service --> repo : UserDTO
end
alt Todos correctos
    repo -> store : hydrateUsers([último UserDTO])
    repo -> local : userLocal.saveBatch(...)
    hook --> screen : void
    screen -> screen : setFavoritesKind(null) (cierra el modal)
else Alguno falla (400 por debajo del mínimo, 403, 404 si el id no existe)
    repo -> store : setUsers([backupUser])
    repo ->> service : getById(userId) -> hydrateUsers\n(recarga en segundo plano: el backend\npuede haber aplicado parte)
    repo --> hook : throw
    hook -> hook : setError('Error al actualizar los favoritos')
    hook --> screen : throw
    screen --> actor : showAlert({ title: 'Error',\nmessage: 'No se pudieron guardar los favoritos' })
end

== 3a. Cerrar sesión ==

actor -> screen : pulsa "Cerrar sesión"
screen --> actor : showAlert('Cerrar sesion', 'Estas seguro?')
actor -> screen : confirma
screen -> hook : useAuth().logout()
hook -> repo : authRepository.logout()
repo -> store : useAuthStore.clearAuth()\nuseUserEntitiesStore.clearUsers()\nuseItemListEntitiesStore.clearItemLists()
repo -> local : Promise.all([ userLocal.clearAll(),\nitemListLocal.clearAll(),\nitemLocal.clearQueryIndexes(['items_catalog']),\nsongLocal.removeQueryIndexes([Spotify,\nrecomendadas, de artistas favoritos]),\nlessonLocal.removeQueryIndexes(\n[recomendadas]) ])
note right of local : Se borran el usuario, sus listas y los\níndices personales. Se conservan el\ncatálogo de items y el contenido público\ncomo caché, y los recientes por usuario.
local --> repo : ok
repo --> hook : void
store ->> screen : isAuthenticated = false
screen --> actor : AppNavigator muestra LoginScreen

@enduml
