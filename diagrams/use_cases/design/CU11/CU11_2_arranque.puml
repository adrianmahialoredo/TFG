@startuml DSD-CU-11-2
title DSD-CU-11 (2/5) - Afinador:\narranque del micrófono (app)

' Parte de la app de la realización de CU-11: start() de useTuner (sin backend), lanzado por
' useFocusEffect al entrar en la pantalla.
' Fuentes: screens/TunerScreen.tsx (useFocusEffect), hooks/useTuner.ts,
' utils/microphone.utils.ts, utils/tuner.utils.ts; architecture.md §12 "Afinador".
' Notas de diseño:
'  - useTuner(tune.notes) calcula noteToFrequency por cuerda. simulated = isMicrophoneSimulated()
'    (isRunningInExpoGo()) se calcula una vez al montar useTuner. getMicrophone() es interna de
'    useTuner y crea el micrófono una sola vez:
'    microphoneRef ??= simulated ? createSimulatedMicrophone(...) : createNativeMicrophone().
'  - En Expo Go el micrófono simulado (setInterval) genera bloques de una cuerda que se va
'    afinando, sin pedir permiso (requestPermission devuelve 'Granted'); en una development
'    build se usa react-native-audio-api.
'  - Tras requestPermission: si session !== sessionRef (se paró mientras esperaba), return.
'  - "Abrir ajustes" llama a Linking.openSettings().
'  - Arranque nativo: [iOS] setAudioSessionOptions(record, measurement) y
'    setAudioSessionActivity(true); recorder ??= new AudioRecorder(); onError(...);
'    onAudioReady({ 44100 Hz, 4096 muestras, 1 canal }); recorder.start().
'  - Si la librería avisa luego por onError, status = 'error'.
!include ../_estilo.iuml

actor "Músico" as actor
box "App" #F3F8FF
    participant "TunerScreen\n<<Nivel 7>>" as screen
    participant "useTuner\n<<Nivel 6>>" as tuner
    participant "Microphone\n(microphone\n.utils)" as mic
end box
participant "react-native\n-audio-api\n<<librería>>" as lib

screen -> tuner : useTuner(tune.notes)
screen -> tuner : start()
tuner -> tuner : si ya graba, return;\nsession = ++sessionRef;\nstatus = 'starting'
tuner -> tuner : microphone =\ngetMicrophone()
tuner -> mic : requestPermission()
mic -> lib : AudioManager.\nrequestRecording\nPermissions()
mic --> tuner : 'Granted' | 'Denied'\n| 'Undetermined'

alt Permiso no concedido
    tuner -> tuner : status = 'denied'
    tuner --> screen : status
    screen --> actor : "El afinador necesita\nel micrófono..." +\n"Abrir ajustes"
else Permiso concedido
    tuner -> mic : start(handleBlock,\nonError)
    mic -> lib : [iOS] sesión de audio;\nnew AudioRecorder();\nonError; onAudioReady
    mic -> lib : recorder.start()
    alt No arranca
        mic -> mic : release()
        mic --> tuner : throw Error
        tuner -> tuner : status = 'error';\nreleaseMicrophone()
        tuner --> screen : status
        screen --> actor : "No se pudo usar\nel micrófono"
    else Grabando
        mic --> tuner : ok
        tuner -> tuner : si se paró:\nreleaseMicrophone();\nsi no, status =\n'listening'
        tuner --> screen : status
        screen --> actor : "Toca una cuerda"
        note over tuner, lib : Sigue en DSD-CU-11 (3/5)
    end
end

@enduml
