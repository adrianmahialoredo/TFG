@startuml DSD-CU-11-5
title DSD-CU-11 (5/5) - Utilizar afinador cromático: endpoints del backend

' Lo que hace el backend en las peticiones de DSD-CU-11 (1/5).
' Fuentes: TuneController.java, TuneServiceImpl.java, InstrumentController.java,
' InstrumentServiceImpl.java, utils/mapper/DtoMapper.java, SecurityConfig.java.
' Ambas rutas exigen un JWT válido (GET de catálogo autenticado; POST /api/*/by-ids es
' lectura y solo pide estar autenticado).
!include ../_estilo.iuml

participant "App" as app
box "Backend (Spring Boot)" #FFF9F0
    participant "X\nController" as ctrl
    participant "X\nServiceImpl" as svc
    participant "X\nRepository" as repo
    participant "Dto\nMapper" as mapper
end box
database "PostgreSQL" as db

group GET /api/tunes
    app -> ctrl : TuneController\n.getAll()
    ctrl -> svc : TuneServiceImpl\n.findAll()
    svc -> repo : TuneRepository\n.findAll()
    repo -> db : SELECT
    db --> repo : List<Tune>
    svc -> mapper : tuneToTuneDto\n(tune)
    mapper --> svc : TuneDTO (id,\ntitle, instrumentId,\nnotes)
    ctrl --> app : 200 List\n<TuneDTO>
end

group POST /api/instruments/by-ids
    app -> ctrl : Instrument\nController\n.getByIds(ids)
    ctrl -> svc : Instrument\nServiceImpl\n.findByIds(ids)
    svc -> repo : Instrument\nRepository\n.findAllById(ids)\n(lista vacía si\nno hay ids)
    repo -> db : SELECT ...\nWHERE id\nIN (...)
    svc -> mapper : instrumentTo\nInstrumentDto\n(instrument)
    ctrl --> app : 200 List\n<InstrumentDTO>
end

@enduml
