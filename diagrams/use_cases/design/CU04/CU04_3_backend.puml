@startuml DSD-CU-04-3
title DSD-CU-04 (3/3) - Explorar catálogo de ítems: endpoints del backend

' Lo que hace el backend en las peticiones de DSD-CU-04 (1/3 y 2/3).
' Fuentes: ItemController.java, ItemServiceImpl.java, GenreController.java, GenreServiceImpl.java,
' utils/mapper/DtoMapper.java, dto/ItemSummaryDTO.java, config/SecurityConfig.java.
!include ../_estilo.iuml

participant "App\n(services)" as app
box "Backend (Spring Boot)" #FFF9F0
    participant "XController\n<<controller>>" as ctrl
    participant "XServiceImpl\n<<service>>" as svc
    participant "XRepository\n<<repository>>" as repo
    participant "DtoMapper\n<<mapper>>" as mapper
end box
database "PostgreSQL" as db

note over ctrl : JwtAuthenticationFilter: cualquier\nusuario autenticado\n(anyRequest().authenticated())

group GET /api/items
    app -> ctrl : ItemController.getAll()
    ctrl -> svc : ItemServiceImpl.findAll()
    svc -> repo : ItemRepository.findAll()
    repo -> db : SELECT
    db --> repo : items (Song, Lesson, Genre, InstrumentGenre)
    repo --> svc : List<Item>
    svc -> mapper : itemsToItemSummaryDTOs(items)
    loop por cada item
        mapper -> mapper : itemToItemSummaryDto(item)
        note right of mapper : id, title, imageUrl, type, level y, según\nel subtipo (Hibernate.unproxy): artist,\ndecade, genreIds, instrumentIds\n(metadatos de búsqueda)
    end
    mapper --> svc : List<ItemSummaryDTO>
    ctrl --> app : 200 List<ItemSummaryDTO>
end

group GET /api/genres
    app -> ctrl : GenreController.getAll()
    ctrl -> svc : GenreServiceImpl.findAll()
    svc -> repo : GenreRepository.findAll()
    repo -> db : SELECT
    svc -> mapper : genreToGenreDto(genre)
    ctrl --> app : 200 List<GenreDTO>
end

@enduml
