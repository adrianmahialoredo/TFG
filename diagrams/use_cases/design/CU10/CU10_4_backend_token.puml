@startuml DSD-CU-10-4
title DSD-CU-10 (4/4) - Vincular cuenta de Spotify: usuario y renovación del token (backend)

' Lo que hace el backend en las peticiones de la vuelta a la app (DSD-CU-10 2/4).
' Fuentes: UserController.java, UserServiceImpl.java, DtoMapper.java,
' SpotifyRecommendationController.java, SpotifyRecommendationServiceImpl.java,
' SpotifyAuthServiceImpl.java, SpotifyUserRepository.java.
' Notas de diseño:
'  - getValidAccessToken(userId) no lo invoca el flujo de vinculación: lo llama
'    SpotifyRecommendationServiceImpl (authorizedRequest) cada vez que consulta la API de Spotify.
'  - Es @Transactional(propagation = REQUIRES_NEW): el llamante es de solo lectura y no
'    guardaría el token renovado.
!include ../_estilo.iuml

participant "App\n(services)" as app
box "Backend (Spring Boot)" #FFF9F0
    participant "UserController /\nSpotifyRecommendation\nController" as ctrl
    participant "UserServiceImpl /\nSpotifyRecommendation\nServiceImpl" as svc
    participant "SpotifyAuthServiceImpl\n<<service>>" as auth
    participant "UserRepository /\nSpotifyUserRepository" as repo
    participant "DtoMapper\n<<mapper>>" as mapper
end box
participant "Spotify Accounts /\nSpotify Web API\n<<sistema externo>>" as spotify

group GET /api/users/{id} (@ownership.isSelf)
    app -> ctrl : UserController.getById(id)
    ctrl -> svc : UserServiceImpl.findById(id)
    svc -> repo : userRepository.findById(id)
    svc -> mapper : userToUserDto(user)
    mapper --> svc : UserDto { spotifyConnected =\nuser.getSpotifyUser() != null }
    ctrl --> app : 200 UserDto / 404
end

group GET /api/spotify/recommendations/items | songs/{userId}
    app -> ctrl : getItemsForUser(userId) | getSongsForUser(userId, limit)
    ctrl -> svc : findItemsForUser | findSongsForUser\n(@Transactional(readOnly = true))
    svc -> auth : authorizedRequest(userId) -> getValidAccessToken(userId)
    activate auth
    auth -> repo : spotifyUserRepository.findByUserId(userId)
    alt Sin cuenta vinculada
        auth --> svc : EntityNotFoundException (404)
    else Token válido (caduca en más de 1 min)
        auth --> svc : accessToken
    else 9a. Caducado o a punto de caducar (dura 1 h)
        auth -> spotify : POST /api/token, Basic(client_id, client_secret)\n{ grant_type=refresh_token, refresh_token }
        alt Rechaza la renovación (acceso revocado, 4xx)
            spotify --> auth : 400 invalid_grant
            auth --> svc : IllegalStateException ("Vuelve a vincular tu cuenta")
            note right of auth : Un 5xx o error de red también da\nIllegalStateException ("Inténtalo más tarde"),\npero se conserva la vinculación
        else Renovado
            spotify --> auth : { access_token, expires_in, [refresh_token] }
            auth -> auth : setAccessToken, setTokenExpiration;\nsetRefreshToken solo si llega uno nuevo
            auth -> repo : save(spotifyUser)
            auth --> svc : nuevo accessToken
        end
    end
    deactivate auth
    svc -> spotify : GET /v1/me/top/tracks | /v1/me/top/artists\n?limit&time_range (Bearer accessToken)
    spotify --> svc : canciones / artistas top del usuario
    svc -> mapper : songToSongDto | item DTOs
    ctrl --> app : 200 List<ItemDTO> | List<SongDTO>
end

@enduml
