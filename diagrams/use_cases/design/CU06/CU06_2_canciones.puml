@startuml DSD-CU-06-2
title DSD-CU-06 (2/4) - Consultar espacio de género: pestaña "Canciones" (app)

' Fuentes: screens/GenreSongsScreen.tsx; hooks/useGenreSongs.ts; repositories/song.repository.ts;
' utils/entityCache.utils.ts; services/song.service.ts. Backend en DSD-CU-06 (4/4).
!include ../_estilo.iuml

actor "Músico" as actor
box "App (React Native)" #F3F8FF
    participant "GenreMainScreen\n(GenreSongsScreen)\n<<Nivel 7>>" as screen
    participant "useGenreSongs\n<<Nivel 6>>" as hooks
    participant "songRepository\n<<Nivel 3>>" as repos
    participant "Entity Stores\n<<Nivel 4>>" as stores
    participant "songService\n<<Nivel 1>>" as services
end box
participant "API REST\n(backend)" as api

actor -> screen : pulsa "Canciones" (changeTab)
screen -> hooks : useGenreSongs(genreId)
par Promise.all de los tres carruseles
    hooks -> repos : getPopularByGenreId(genreId, onFresh)
else
    hooks -> repos : getClassicByGenreId(genreId, onFresh)
else
    hooks -> repos : getNewByGenreId(genreId, onFresh)
end

loop por carrusel (popular | classic | new)
    note right of repos : cache.list('<tipo>_genre_{genreId}')
    repos -> services : get<Tipo>ByGenreId(genreId)
    services -> api : GET /api/songs/by-genre/{genreId}/popular|classic|new
    api --> services : 200 List<SongDTO>\n(DTO completo: excepción de negocio)
    services --> repos : SongDTO[]
    repos -> stores : setSongs(songs) + setItems(resúmenes) + índice
    repos --> hooks : ids (y onFresh(ids) si había caché)
end

hooks -> stores : useItemEntitiesStore(state => state.items)
hooks -> hooks : itemsToCarouselItems(...) por carrusel
hooks --> screen : { populars, classics, news }
screen --> actor : SongsCarousel "Populares", "Clásicos del Género"\ny "Novedades" (los vacíos no se muestran)
note right of actor : Al pulsar una canción se abre\nSongScreen (DSD-CU-05)

@enduml
