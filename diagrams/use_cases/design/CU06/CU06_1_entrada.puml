@startuml DSD-CU-06-1
title DSD-CU-06 (1/8) - Consultar espacio de género: entrada y carga del género (app)

' Parte de la app de la realización de CU-06. El backend se dibuja como una sola línea de
' vida ("API REST"); lo que hace cada endpoint está en DSD-CU-06 (7/8 y 8/8).
' Partes: (1/8) entrada y carga del género; (2/8) instrumentos, lecciones y descripción;
' (3/8) pestaña "Canciones"; (4/8) pestaña "Instrumentos" y carga del itinerario;
' (5/8) carga de la lección del itinerario; (6/8) lección mostrada y navegación;
' (7/8 y 8/8) backend.
' Fuentes: screens/GenreMainScreen.tsx, GenreDescriptionScreen.tsx; hooks/useGenreMain.ts,
' useGenreDescription.ts; repositories/genre, instrumentGenre, lesson, item .repository.ts;
' utils/entityCache.utils.ts; services/genre, instrumentGenre, lesson .service.ts.
' GenreDescriptionScreen, GenreSongsScreen y GenreInstrumentsScreen son pestañas embebidas
' en GenreMainScreen (no rutas).
' Para que quepa en A4, los service (Nivel 1) no tienen línea de vida: cada flecha
' "Repositories -> API REST" es la llamada al service indicado, que hace la petición HTTP.
!include ../_estilo.iuml

actor "Músico" as actor
box "App (React Native)" #F3F8FF
    participant "GenreMain\nScreen\n<<Nivel 7>>" as screen
    participant "useGenreMain\n<<Nivel 6>>" as hooks
    participant "Repositories\n<<Nivel 3>>" as repos
    participant "Entity Stores\n<<Nivel 4>>" as stores
end box
participant "API REST" as api

actor -> screen : pulsa un género: navigate(\n'GenreMainScreen', { genreId })
screen -> hooks : useGenreMain(genreId)
hooks -> repos : Promise.allSettled([ genreRepository\n.getById, instrumentGenreRepository\n.getByGenreId, lessonRepository\n.getByGenreId ])
note right of hooks : las dos últimas,\nen DSD-CU-06 (2/8)

group genreRepository.getById(genreId)
    repos -> stores : genres[id]
    alt en RAM o en disco (genreLocal.getById)
        stores --> repos : GenreDTO
        repos ->> api : cache.revalidate(\n[id]): POST /api/genres/by-ids (segundo plano)
    else cache-miss
        repos -> api : genreService\n.getById(id): GET /api/genres/{id}
        api --> repos : 200 GenreDTO (404 si no existe)
        repos -> repos : cache.markFresh([id]), genreLocal\n.saveBatch([genre])
    end
    repos -> stores : useGenreEntitiesStore\n.setGenres([genre])
end

@enduml
