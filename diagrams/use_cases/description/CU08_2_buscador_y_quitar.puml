@startuml DS-CU-08-2
title DS-CU-08 (2/2) - Añadir/eliminar ítems en listas: añadir desde el buscador y quitar

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: SearchResults.tsx, AddToListModal.tsx, ItemListPickerModal.tsx, useAddToList.ts,
' ListScreen.tsx, useItemListDetail.ts, itemList.repository.ts, ItemListController.java
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6

actor "Músico" as musico
boundary "CatalogoView" as buscador
boundary "ListaScreen" as listaScreen
control "GestorListas" as gestor
entity "ItemList" as lista

== Añadir desde el buscador de Canciones o Aprender ==

musico -> buscador : pulsarAnadir(itemId)
note right of buscador : Botón + de cada resultado\nde búsqueda (DS-CU-04)
buscador -> gestor : obtenerListas(userId)
gestor --> buscador : listas
buscador --> musico : mostrarModal("Añadir a una lista", listas)
note right of buscador : Ordenadas por nombre; las que ya\ncontienen el ítem salen con tic y\nno se pueden pulsar. Sin listas:\n"Aún no tienes listas. Puedes\ncrearlas desde tu perfil."
musico -> buscador : elegirLista(listId)
buscador -> gestor : anadirItem(listId, itemId)
note right of gestor : POST /api/item-lists/{listId}/items/{itemId}
gestor -> lista : comprobarPropiedad(listId, userId)
alt La petición falla (sin red, 403 o lista inexistente)
    gestor --> buscador : error
    buscador --> musico : mostrarError("No se pudo añadir a la lista")
else Éxito
    gestor -> lista : asociarItemALista(item)
    lista --> gestor : ItemListDTO
    gestor --> buscador : 200 OK + ItemListDTO
    buscador -> buscador : actualizarEstadoLocal(lista)
    buscador --> musico : marcarConTic() y cerrarModal()
end

== 1a. Quitar un ítem de la lista ==

musico -> listaScreen : quitarItem(itemId)
listaScreen --> musico : solicitarConfirmacion("Quitar de la lista")

alt El músico cancela
    musico -> listaScreen : cancelar()
else El músico confirma
    musico -> listaScreen : confirmar()
    listaScreen -> gestor : eliminarItem(listId, itemId)
    note right of gestor : DELETE /api/item-lists/{listId}/items/{itemId}
    gestor -> lista : comprobarPropiedad(listId, userId)
    alt La petición falla (sin red, 403 o lista inexistente)
        gestor --> listaScreen : error
        listaScreen --> musico : mostrarError("No se pudo quitar el item de la lista")
    else Éxito
        gestor -> lista : desvincularItem(itemId)
        lista --> gestor : ItemListDTO
        gestor --> listaScreen : 200 OK + ItemListDTO
        listaScreen -> listaScreen : actualizarEstadoLocal(lista)
        note right of listaScreen : RAM y disco
        listaScreen --> musico : refrescarVista()
    end
end

@enduml
