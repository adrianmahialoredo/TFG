@startuml DS-CU-03-3
title DS-CU-03 (3/3) - Configurar perfil:\nfoto y cierre de sesión

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: ProfileScreen.tsx, useProfile.ts, user.repository.ts, auth.repository.ts (logout),
' UserController.java, UserServiceImpl.java
' Partes: (1/3) CU03_1_datos_perfil.puml; (2/3) CU03_2_favoritos.puml; (3/3) este.
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6
skinparam maxMessageSize 130
skinparam wrapWidth 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam defaultFontSize 12

actor "Músico" as musico
boundary "PerfilScreen" as pantalla
control "GestorPerfil" as gestor
control "Gestor\nAutenticacion" as auth
entity "Usuario" as usuario
participant "Cloudinary\n<<sistema\nexterno>>" as cloudinary

note over musico, pantalla : El músico está en su\nperfil (DS-CU-03 (1/3))

alt Cambiar foto
    musico -> pantalla : cambiarFoto()
    pantalla --> musico : abrirGaleria()
    musico -> pantalla : elegirImagen(uri)
    pantalla -> cloudinary : subirImagen(uri)
    cloudinary --> pantalla : secureUrl
    pantalla -> gestor : guardarPerfil(userId, profileImageUrl = secureUrl)
    note left of gestor : PUT\n/api/users/{id}
    gestor -> usuario : actualizar(profileImageUrl)
    gestor --> pantalla : 200 OK + usuarioActualizado
    pantalla --> musico : mostrarFoto()
    opt Falla la subida o el guardado
        pantalla --> musico : mostrarError("No se pudo actualizar la foto de perfil")
    end
else 3a. Cerrar sesión
    musico -> pantalla : cerrarSesion()
    pantalla --> musico : pedirConfirmacion("¿Estás seguro?")
    musico -> pantalla : confirmar()
    pantalla -> auth : cerrarSesion()
    auth -> auth : borrarDatosPersonalesLocales()
    note right of auth : Sin petición al backend.\nUsuario, listas e índices\npersonales (RAM y disco).\nEl contenido público\nsigue en caché.
    auth --> pantalla : sesionCerrada
    pantalla --> musico : redirigirLogin()
end

@enduml
