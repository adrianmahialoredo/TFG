@startuml DS-CU-06
title DS-CU-06 - Consultar espacio de género

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: GenreMainScreen.tsx, useGenreMain.ts, GenreDescriptionScreen.tsx, GenreSongsScreen.tsx,
' useGenreSongs.ts, GenreInstrumentsScreen.tsx, useGenreInstruments.ts,
' InstrumentGenreLessonScreen.tsx, useInstrumentGenre.ts, useInstrumentGenreLesson.ts, useLesson.ts
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6

actor "Músico" as musico
boundary "GenreScreen" as pantalla
boundary "ItinerarioInstrumentoScreen" as itinerario
control "GestorGeneros" as gestor
entity "Genre" as genre
entity "Song" as song
entity "InstrumentGenre" as ig
entity "Lesson" as lesson

musico -> pantalla : abrirEspacioGenero(id)
pantalla -> gestor : obtenerDetalleGenero(id)
par Carga en paralelo
    gestor -> genre : obtener(id)
    genre --> gestor : GenreDTO (banner, descripción,\nvídeos de bienvenida)
else
    gestor -> ig : obtenerPorGenero(genreId)
    note right of ig : GET /api/instrument-genres\n/by-genre/{id}
    ig --> gestor : InstrumentGenreDTO[]
else
    gestor -> lesson : obtenerPorGenero(genreId)
    lesson --> gestor : LessonDTO[]
end
gestor ->> gestor : marcarRecienteLocal(id)
gestor --> pantalla : género
pantalla --> musico : mostrarPestanaGenero(banner, descripción, vídeos)
note right of pantalla : Pestañas "Instrumentos", "Canciones" y\n"Género"; se abre en "Género"

opt Pestaña "Canciones"
    musico -> pantalla : abrirPestanaCanciones()
    pantalla -> gestor : cargarCarruselesCanciones(id)
    par Cada carrusel se pinta en cuanto llega
        gestor -> song : obtenerPopulares(genreId)
        song --> gestor : SongDTO[]
    else
        gestor -> song : obtenerClasicas(genreId)
        song --> gestor : SongDTO[]
    else
        gestor -> song : obtenerNuevas(genreId)
        song --> gestor : SongDTO[]
    end
    gestor --> pantalla : carruseles
    pantalla --> musico : mostrarCarruseles("Populares",\n"Clásicos del Género", "Novedades")
end

opt Pestaña "Instrumentos"
    musico -> pantalla : abrirPestanaInstrumentos()
    pantalla -> gestor : obtenerInstrumentGenres(genreId)
    note right of gestor : Sin peticiones: ya se cargaron al abrir el género
    gestor --> pantalla : módulos
    pantalla --> musico : mostrarModulosInstrumento()

    musico -> pantalla : seleccionarInstrumento(instrumentGenreId)
    pantalla -> itinerario : mostrar(instrumentGenreId)
    itinerario -> gestor : cargarLeccionesItinerario(instrumentGenreId)
    gestor -> lesson : obtenerTodas(instrumentGenre.lessonIds)
    note left of lesson : RAM -> disco -> API.\nEn el orden del backend\n(el cliente no ordena)
    lesson --> gestor : LessonDTO[] + LessonSection[]
    gestor ->> gestor : marcarRecienteLocal(instrumentGenreId)
    gestor --> itinerario : itinerario
    itinerario --> musico : mostrarLeccion(primera lección, secciones)
    note right of itinerario : Cada sección muestra su vídeo de\napoyo de YouTube (si tiene) y su\ncontenido HTML; flechas entre secciones

    opt 6a. El músico elige otra lección en el panel lateral
        musico -> itinerario : abrirPanelLateral()
        itinerario --> musico : mostrarLecciones()
        musico -> itinerario : seleccionarLeccion(lessonId)
        itinerario --> musico : mostrarLeccion(lessonId, secciones)
    end
end

@enduml
