@startuml DS-CU-12
title DS-CU-12 - Utilizar metrónomo

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: MetronomeScreen.tsx, useMetronome.ts (useMetronome, useTapTempo), MetronomeSlider.tsx,
' MetronomePulse.tsx, MetronomeBeatIndicator.tsx
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6

actor "Músico" as musico
boundary "MetronomoScreen" as pantalla
control "MotorRitmo" as motor
boundary "SalidaAudio" as audio

musico -> pantalla : abrirMetronomo()
pantalla -> motor : cargarSonidos(click, hihat)
note right of pantalla : Sin configuración guardada: estado de la\npantalla, empieza en 120 BPM y sonido click
pantalla --> musico : mostrarControles(BPM 30-300, -10/-1/+1/+10,\nTAP TEMPO, Hi-Hat)

opt Ajustar el tempo
    alt Deslizador o botones -10 / -1 / +1 / +10
        musico -> pantalla : ajustarBPM(bpm)
        pantalla -> pantalla : acotar(bpm, 30, 300)
    else 3a. Tap Tempo
        loop Por cada toque
            musico -> pantalla : pulsarTapTempo()
            pantalla -> motor : registrarPulsacion(instante)
            note right of motor
                Si pasan más de 2 s desde el toque anterior, empieza de nuevo.
                Con al menos 2 toques: promedio de los últimos 4 intervalos.
            end note
            motor --> pantalla : bpmCalculado (o nada)
            pantalla -> pantalla : acotar(bpm, 30, 300)
        end
    end
    pantalla -> motor : fijarBPM(bpm)
    pantalla --> musico : mostrarBPM()
end

opt Cambiar sonido (click | hihat)
    musico -> pantalla : pulsarHiHat()
    pantalla -> motor : fijarSonido(click | hihat)
end
note over pantalla, motor : Compás fijo de 4 tiempos, el primero acentuado.\nCon el metrónomo en marcha, los cambios se aplican desde el siguiente golpe

musico -> pantalla : tocarCirculoCentral()
pantalla -> motor : iniciar()
loop Cada 60 / BPM segundos, hasta que se detiene
    motor -> audio : reproducirGolpe(acentuado si es el primer tiempo)
    motor --> pantalla : pulso(tiempoEnCompas)
    pantalla --> musico : animarOnda(), resaltarTiempo(tiempoEnCompas)
    motor -> motor : programarSiguienteGolpe()
    note right of motor : setTimeout de JS calculado desde el instante\nteórico del golpe anterior: sin deriva acumulada
end

alt El músico toca de nuevo el círculo central
    musico -> pantalla : tocarCirculoCentral()
    pantalla -> motor : detener()
else El músico sale de la pantalla
    musico -> pantalla : salir()
    pantalla -> motor : detener()
end
pantalla --> musico : apagarIndicadorDeTiempos()

@enduml
