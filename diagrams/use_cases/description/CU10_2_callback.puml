@startuml DS-CU-10-2
title DS-CU-10 (2/3) - Vincular cuenta de Spotify:\ncallback, tokens y vuelta a la app

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: SpotifyButton.tsx, useSpotifyConnect.ts, spotify.repository.ts, useHomeItems.ts, useFeedSongs.ts,
' SpotifyAuthController.java, SpotifyAuthServiceImpl.java, SpotifyRecommendationServiceImpl.java
' Partes: (1/3) autorización en Spotify (CU10_1_autorizacion.puml); (2/3) callback, tokens y vuelta
' a la app (CU10_2_callback.puml); (3/3) renovación del token (CU10_3_renovacion.puml).
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6
skinparam maxMessageSize 130
skinparam wrapWidth 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam defaultFontSize 12

actor "Músico" as musico
boundary "PerfilScreen" as perfil
boundary "Navegador\nExterno" as navegador
control "Gestor\nSpotifyAuth" as gestor
entity "Usuario" as usuario
entity "SpotifyUser\nCredencial" as credencial
participant "SpotifyAPI\n<<sistema\nexterno>>" as spotify

note over gestor, spotify : Viene de DS-CU-10 (1/3):\npermisos concedidos

spotify -> gestor : callback(code, state)
note left of gestor : GET /api/spotify/\ncallback
gestor -> gestor : validarState(state)
alt state inválido o caducado
    gestor --> navegador : 400 Bad Request
    navegador --> musico : vinculaciónNoRealizada
else state válido (se consume)
    gestor -> spotify : intercambiarTokens(code)
    note left of spotify : client_id y\nclient_secret en la\ncabecera Basic
    spotify --> gestor : accessToken, refreshToken, expiresIn
    gestor -> spotify : obtenerPerfil(accessToken)
    spotify --> gestor : spotifyUserId

    opt 7a. La cuenta de Spotify ya\npertenecía a otro usuario
        gestor -> usuario : desvincular(\nusuarioAnterior)
    end

    gestor -> credencial : guardarTokens(spotifyUserId, accessToken, refreshToken)
    gestor -> usuario : asociarCuenta(credencial)
    gestor --> navegador : 200 + página HTML "¡Spotify conectado! Ya puedes volver a la app."
    navegador --> musico : "Vuelve a la app"
end

musico -> perfil : volverALaApp()
perfil -> usuario : recargarUsuario(userId)
note right of usuario : GET /api/users/{id}\n(spotifyConnected)
usuario --> perfil : usuario
perfil --> musico : recargarCarruseles\nSpotify()
note right of perfil : Si ya está vinculado,\nInicio y Canciones\npiden sus\nrecomendaciones\nde Spotify

@enduml
