@startuml DS-CU-01-2
title DS-CU-01 (2/2) - Registrar nuevo usuario: registro con el código

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: RegisterScreen.tsx, EmailVerificationModal.tsx, useRegister.ts, auth.service.ts,
' AuthContext.tsx, AuthController.java, EmailVerificationServiceImpl.java, UserServiceImpl.java
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6

actor "Visitante" as visitante
boundary "ModalVerificacionEmail" as modal
control "GestorAutenticacion" as gestor
entity "CodigoVerificacion" as codigo
entity "Usuario" as usuario
entity "AlmacenSeguro" as almacen
entity "DatosGlobales\n(catálogo, géneros)" as datos

note over visitante, modal : Viene de DS-CU-01 (1/2): el modal muestra el campo del código

visitante -> modal : introducirCodigo(codigo)
modal -> gestor : registrarUsuario(datos, codigo)
note right of gestor : POST /api/auth/register
gestor -> codigo : comprobarCodigo(email, codigo)

alt Código incorrecto, caducado o demasiados intentos
    codigo --> gestor : código no válido
    gestor --> modal : 400 Bad Request
    modal --> visitante : mostrarErrorCodigo()\n(o pedir uno nuevo)
else Código correcto
    codigo --> gestor : ok
    gestor -> usuario : comprobarEmailYUsernameUnicos()
    alt Username ocupado
        usuario --> gestor : ocupado
        gestor --> modal : 400 "Username already taken"
        modal --> visitante : mostrarError("Ese nombre de usuario ya está en uso")
        note right of modal : El código no se consume:\nse corrige y se reintenta
    else Libres
        usuario --> gestor : ok
        gestor -> gestor : cifrarPassword(pass)
        gestor -> usuario : persistirUsuario(datos, rol = USER)
        usuario --> gestor : usuario
        gestor -> codigo : consumir(email)
        gestor -> gestor : generarJWT(id, rol)
        gestor --> modal : 201 Created + LoginResponse(token, perfil)
        modal -> almacen : guardarSesionLocal(token, perfil)
        note right of almacen : AuthStore + UserEntitiesStore\n(en RAM y disco)
        note over gestor, datos : AuthProvider detecta la sesión y precarga los datos globales
        gestor ->> datos : precargarCatalogoItems()
        note right of datos : GET /api/items\n(en segundo plano)
        gestor -> datos : precargarGeneros()
        datos --> gestor : géneros
        modal --> visitante : redirigirPantallaPrincipal()
    end
end
@enduml
