@startuml DS-CU-07
title DS-CU-07 - Gestionar listas de estudio

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6

actor "Músico" as musico
boundary "ListasScreen" as pantalla
control "GestorListas" as gestor
entity "ItemList" as lista
entity "Usuario" as usuario

musico -> pantalla : abrirMisListas()
pantalla -> gestor : obtenerListas(userId)
gestor -> lista : obtenerIdsPorUsuario(userId)
note right of lista : GET /api/item-lists/by-user/{userId}/ids
lista --> gestor : ids
gestor -> lista : obtenerTodas(ids)
lista --> gestor : ItemListDTO[]
gestor --> pantalla : listas
pantalla --> musico : mostrarListas()

alt Crear lista
    musico -> pantalla : solicitarCreacion(nombre, imagen)
    pantalla -> gestor : crearLista(userId, nombre, imagen)
    note right of gestor : POST /api/item-lists
    gestor -> usuario : verificarPropiedad(userId)
    usuario --> gestor : ok
    gestor -> lista : persistirLista(userId, nombre, imagen)
    lista --> gestor : ItemListDTO
    gestor --> pantalla : ItemListDTO
    pantalla -> pantalla : actualizarAlmacenLocal(lista)
    note right of pantalla : Inserción atómica en RAM y disco,\nsin recarga global de red
    pantalla --> musico : mostrarListaCreada()
else 3a. Renombrar o editar una lista
    musico -> pantalla : editarLista(id, nombre, imagen)
    pantalla -> gestor : actualizarLista(id, nombre, imagen)
    note right of gestor : PUT /api/item-lists/{id}
    gestor -> lista : verificarPropiedad(id, userId)
    gestor -> lista : actualizar(nombre, imagen)
    lista --> gestor : ItemListDTO
    gestor --> pantalla : ItemListDTO
    pantalla -> pantalla : actualizarAlmacenLocal(lista)
    pantalla --> musico : mostrarListaActualizada()
else 3b. Eliminar una lista
    musico -> pantalla : eliminarLista(id)
    pantalla --> musico : solicitarConfirmacion()
    musico -> pantalla : confirmar()
    pantalla -> gestor : eliminarLista(id)
    note right of gestor : DELETE /api/item-lists/{id}
    gestor -> lista : verificarPropiedad(id, userId)
    gestor -> lista : eliminar(id)
    gestor --> pantalla : ok
    pantalla -> pantalla : purgarAlmacenLocal(id)
    note right of pantalla : RAM y disco
    pantalla --> musico : quitarListaDeVista()
end

@enduml
