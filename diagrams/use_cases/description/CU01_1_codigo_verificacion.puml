@startuml DS-CU-01-1
title DS-CU-01 (1/3) - Registrar nuevo usuario:\nformulario y petición del código

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: RegisterScreen.tsx, EmailVerificationModal.tsx, useRegister.ts, auth.service.ts,
' AuthContext.tsx, AuthController.java, EmailVerificationServiceImpl.java, UserServiceImpl.java
' Partes: (1/3) formulario y petición del código; (2/3) generación, envío y reenvío del código
' (CU01_2_envio_codigo.puml); (3/3) registro con el código (CU01_3_registro.puml).
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6
skinparam maxMessageSize 130
skinparam wrapWidth 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam defaultFontSize 12

actor "Visitante" as visitante
boundary "RegistroScreen" as pantalla
boundary "Modal\nVerificacionEmail" as modal
control "Gestor\nAutenticacion" as gestor
entity "Usuario" as usuario

visitante -> pantalla : accederRegistro()
pantalla --> visitante : mostrarFormulario(nombre, email, username, password, confirmación, favoritos)
visitante -> pantalla : solicitarRegistro(datos)
pantalla -> pantalla : validarFormato()

alt 4a. Datos con formato inválido
    pantalla --> visitante : mostrarError(primera regla incumplida)
else Datos válidos

    pantalla -> gestor : solicitarCodigo(email)
    note left of gestor : POST /api/auth/\nverification-code
    gestor -> usuario : comprobarEmailUnico(email)
    usuario --> gestor : resultado

    alt 6a. El email ya está registrado
        gestor --> pantalla : 400 "Email already registered"
        pantalla --> visitante : mostrarError("Ya existe una cuenta con ese email")
    else Se pidió otro código hace menos de 60 s
        gestor --> pantalla : 429 Too Many Requests
        pantalla -> modal : abrir(email)
        modal --> visitante : mostrarAviso("Ya te enviamos un código hace poco, revisa tu email")
    else Email libre
        note over gestor, usuario : Continúa en DS-CU-01 (2/3):\ngeneración y envío del código
    end
end

@enduml
