@startuml DS-CU-05
title DS-CU-05 - Consultar detalle de canción y lección

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: SongScreen.tsx, useSong.ts, song.repository.ts, songScreen.store.ts, ChordModal.tsx
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6

actor "Músico" as musico
boundary "SongDetailScreen" as pantalla
control "GestorCanciones" as gestor
entity "Song" as song
entity "SongLesson" as leccion
entity "Chord" as chord
entity "TabSection" as tab

musico -> pantalla : seleccionarCancion(id)
pantalla -> gestor : solicitarCancion(id)
gestor ->> gestor : marcarRecienteLocal(id)
note right of gestor : Al entrar, para "Recientes"\ndel Inicio (en segundo plano)
gestor -> song : obtener(id)
note right of song : RAM -> disco -> API\n(GET /api/songs/{id})

alt Canción no encontrada (404 o error)
    song --> gestor : nada
    gestor --> pantalla : sin canción
    pantalla --> musico : mostrarAviso("Canción no encontrada")
else Canción encontrada
    song --> gestor : SongDTO
    gestor -> leccion : obtenerTodas(song.lessonIds)
    leccion --> gestor : SongLessonDTO[]
    par Dependencias de todas las lecciones
        gestor -> chord : obtenerAcordes(chordIds)
        chord --> gestor : ChordDto[]
    else
        gestor -> tab : obtenerTabSections(tabSectionsIds)
        tab --> gestor : TabSectionDTO[]
    end
    gestor -> gestor : seleccionarLeccionPorDefecto(favoritos, nivel)
    note right of gestor
        Instrumento: el primero favorito del usuario
        que tenga lecciones (si no, el de la primera).
        Dificultad: ORIGINAL si el nivel es >= 4 y existe;
        si no, la de la primera lección de ese instrumento.
    end note
    gestor --> pantalla : canción + lecciones + lección seleccionada

    alt No hay lecciones disponibles
        pantalla --> musico : mostrarAviso("No hay lecciones disponibles\npara esta canción")
    else Hay lecciones
        pantalla --> musico : mostrarDetalle(carátula, título, artista,\nchordedLyrics, vídeo de YouTube, acordes, tablaturas)

        opt 3a. Cambiar instrumento o dificultad (EASY, MEDIUM, ORIGINAL)
            musico -> pantalla : cambiarInstrumento(id) / cambiarDificultad(dificultad)
            pantalla -> gestor : seleccionarLeccion(instrumento, dificultad)
            note right of gestor : Sin peticiones: las lecciones,\nacordes y tablaturas ya están cargados
            gestor --> pantalla : lección
            pantalla --> musico : actualizarLetraAcordesYTablatura()
        end

        opt 5a. El músico pulsa un acorde
            musico -> pantalla : seleccionarAcorde(chordId)
            pantalla --> musico : mostrarModalAcorde(nombre, diagrama, propiedades, capo)
            note right of pantalla : Propiedades como tags (Mayor, Menor,\nSéptima, Power chord, Abierto, Cejilla)\ny el traste del capo ("Sin capo" si es 0)
            musico -> pantalla : cerrarModal()
        end
    end
end

@enduml
