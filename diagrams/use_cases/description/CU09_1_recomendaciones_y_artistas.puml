@startuml DS-CU-09-1
title DS-CU-09 (1/2) - Consultar recomendaciones adaptativas: recomendaciones y artistas favoritos

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
' Fuentes: HomeScreen.tsx, useHomeItems.ts, useAddItemScreen.ts, song.repository.ts,
' ItemRecommendationServiceImpl.java, Song/Lesson/Genre/InstrumentGenreRecommendationServiceImpl.java,
' User.getIdsExcludedFromRecommendationsOfType, RecommendationConstants.java
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6

actor "Músico" as musico
boundary "RecomendacionesView" as vista
control "MotorRecomendacion" as motor
entity "ItemList" as lista
entity "Usuario" as usuario
entity "Item" as item
entity "Song" as cancion

== Recomendaciones adaptativas ==

musico -> vista : abrirRecomendaciones()
note right of musico : "Para ti": en Inicio\no dentro de una lista
vista -> motor : pedirRecomendaciones(origenId)
note right of motor : GET /api/recommendations/items/by-user/{id}\no .../by-item-list/{id}

motor -> usuario : obtenerFavoritosYNivel(userId)
usuario --> motor : géneros, instrumentos, nivel
motor -> lista : obtenerItems(origenId)
lista --> motor : ítems ya incluidos
motor -> motor : calcularTopGenerosEInstrumentos()
note right of motor : getTopNMostRepeated

alt 4a. Lista nueva o usuario sin historial
    motor -> motor : saltarANivelesDeRespaldo(favoritos, nivel)
else Hay historial
    motor -> motor : ejecutarAlgoritmoNiveles()
    note right of motor
        Nivel 1: coincidencia estricta
        Nivel 2: reparto
        Nivel 3: favoritos y nivel de destreza
        Nivel 4: general
    end note
end

loop Por cada tipo y nivel, hasta completar el cupo
    note right of motor
        20 en una lista (10 canciones / 1 género /
        3 instrumento-género / 6 lecciones)
        12 en Inicio (6 / 1 / 2 / 3)
    end note
    motor -> item : buscarCandidatos(criterios, filtrarExclusiones(idsPrevios))
    note right of item
        Se excluye lo ya elegido y:
        - en una lista: lo que ya está en esa lista
        - en Inicio: lo que está en 3 o más listas
        (cláusulas ...IdNotIn)
    end note
    item --> motor : candidatos
end

motor -> motor : unificarYBarajar()
note right of motor : SequencedSet sin repetidos;\nse baraja en los dos casos
motor --> vista : retornarItemsPolimorficos()
note right of vista : SongDTO, LessonDTO, GenreDTO,\nInstrumentGenreDTO...
vista --> musico : mostrarTarjetasCarrusel()

== Artistas favoritos (solo en Inicio) ==

vista -> motor : pedirCancionesDeArtistasFavoritos(userId)
motor -> usuario : obtenerArtistasFavoritos(userId, 5)
note right of usuario : Los artistas que más se repiten\nen las canciones de sus listas
usuario --> motor : artistas

alt 9a. Sus listas no tienen canciones
    motor --> vista : sin artistas
    vista --> musico : mostrarAvisoListasVacias()
    note right of vista : Sin tarjetas; los dos carruseles muestran\n"Añade canciones a tus listas para..."
else Hay artistas
    par Novedades y populares
        motor -> cancion : buscarNuevas(artistas, 12)
        cancion --> motor : canciones nuevas
    else
        motor -> cancion : buscarPopulares(artistas, 12)
        cancion --> motor : canciones populares
    end
    motor -> motor : intercalarPorTurnos(artistas)
    note right of motor : Una canción de cada artista por turno,\nen orden de importancia del artista
    motor --> vista : canciones nuevas y populares
    vista --> musico : mostrarTarjetasYCarruseles()
    note right of vista
        Tarjeta "Lo nuevo de <artista>" + carrusel "Novedades de tus artistas"
        Tarjeta "Lo más popular de <artista>" + carrusel "Populares de tus artistas"
        Las tarjetas no repiten lo que ya sale en Recientes,
        "Para ti" ni "Basado en tu Spotify".
        Un carrusel sin canciones no se muestra si hay alguna tarjeta.
    end note
end

@enduml
