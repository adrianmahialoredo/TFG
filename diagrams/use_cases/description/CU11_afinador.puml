@startuml DS-CU-11
title DS-CU-11 - Utilizar afinador cromático

' Diagrama de secuencia de análisis (patrón Boundary-Control-Entity)
autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam roundcorner 6

actor "Músico" as musico
boundary "AfinadorScreen" as pantalla
control "GestorAfinaciones" as gestor
entity "Afinacion" as afinacion
control "ProcesadorAudio" as procesador
boundary "Microfono" as microfono

== Carga de las afinaciones ==

musico -> pantalla : abrirAfinador()
pantalla -> gestor : obtenerAfinaciones()
gestor -> afinacion : obtenerTodas()
afinacion --> gestor : afinaciones (instrumento, nombre, notas por cuerda)
gestor --> pantalla : afinaciones ordenadas por instrumento
pantalla -> pantalla : seleccionarPorDefecto(instrumentos favoritos)
pantalla --> musico : mostrarCuerdas(), mostrarRuedaAfinaciones()

alt No hay afinaciones (sin conexión ni caché)
    pantalla --> musico : avisarSinAfinaciones()
end

== Escucha ==

pantalla -> procesador : iniciarEscucha(notas de la afinación)
procesador -> microfono : solicitarPermiso()

alt Permiso de micrófono denegado
    microfono --> procesador : denegado
    procesador --> pantalla : permisoDenegado
    pantalla --> musico : avisarNecesidadMicrofono()\nofrecerAbrirAjustes()
else Permiso concedido
    microfono --> procesador : concedido
    procesador -> microfono : grabar(44.1 kHz, bloques de 4096 muestras)

    loop Cada bloque de audio (~10 por segundo) mientras se escucha
        musico -> microfono : hacerSonarCuerda()
        microfono --> procesador : bloque de audio

        alt Silencio o ruido (volumen bajo o sin periodicidad)
            procesador -> procesador : descartarBloque()
            note right of procesador : Se mantiene la última lectura
        else Nota detectada
            procesador -> procesador : extraerFrecuenciaFundamental() (YIN)
            procesador -> procesador : suavizar(mediana de 3 bloques)
            alt Cuerda fijada por el músico
                procesador -> procesador : compararCon(cuerda fijada)
            else Detección automática
                procesador -> procesador : buscarCuerdaMasCercana(cents)
            end
            procesador -> procesador : calcularDesviacion(cents)
            procesador --> pantalla : cuerda, frecuencia, desviación
            pantalla --> musico : resaltarCuerda(), moverAguja(),\nmostrar(cents, Hz, Tensar/Destensar/Afinado)
            note right of pantalla : Aguja vertical y verde: afinada (±5 cents)\nA la izquierda: baja (tensar)\nA la derecha: alta (destensar)
        end
    end
end

== Acciones del músico durante la escucha ==

alt Fijar o soltar una cuerda
    musico -> pantalla : pulsarCuerda(i)
    pantalla -> procesador : fijarCuerda(i | ninguna)
    note right of procesador : Si no estaba escuchando, empieza a escuchar
else Cambiar de afinación
    musico -> pantalla : elegirAfinacion(rueda)
    pantalla -> procesador : detenerEscucha()
    pantalla --> musico : mostrarCuerdas(nueva afinación)
    note right of pantalla : Se vuelve a escuchar tocando\nel medidor o una cuerda
else Pausar / reanudar
    musico -> pantalla : pulsarMedidor()
    pantalla -> procesador : detenerEscucha() / iniciarEscucha()
end

== Salida ==

musico -> pantalla : salirDelAfinador()
pantalla -> procesador : detenerEscucha()
procesador -> microfono : liberar()

@enduml
