@startuml ER-b
title ER-b - Diagrama entidad-relación: canciones, acordes y afinaciones

' =====================================================================
' Esquema físico de la base de datos PostgreSQL (2/3).
' Generado por Hibernate (spring.jpa.hibernate.ddl-auto=update) a partir
' de las entidades de com.uo289390.toco.model (camelCase -> snake_case).
' Partes: ER-a jerarquía Item y lecciones; ER-b canciones y contenido;
'         ER-c usuarios, listas y Spotify.
'
' Leyenda:
'   PK  clave primaria        FK  clave foránea
'   NN  NOT NULL explícito    UQ  UNIQUE
'   Los campos primitivos (int, boolean) son siempre NOT NULL.
'   Tablas con <<ver ER-x>>: se detallan en otra parte.
'   songs_instruments no tiene @JoinTable: nombres por defecto de JPA.
' =====================================================================

hide circle
hide empty members
skinparam linetype ortho
skinparam roundcorner 6
skinparam class {
    BackgroundColor<<join>> #F3F3F3
    BackgroundColor<<ver ER-a>> #FFF4E0
    BorderColor<<ver ER-a>> #999999
}

entity "songs" as songs <<ver ER-a>> {
    * id : bigint <<PK, FK>>
}

entity "genres" as genres <<ver ER-a>> {
    * id : bigint <<PK, FK>>
}

entity "instruments" as instruments {
    * id : bigint <<PK>>
    --
    * name : varchar <<NN, UQ>>
    * image_url : varchar <<NN>>
}

entity "song_genre" as song_genre <<join>> {
    * song_id : bigint <<PK, FK>>
    * genre_id : bigint <<PK, FK>>
}

entity "songs_instruments" as songs_instruments <<join>> {
    * song_id : bigint <<PK, FK>>
    * instruments_id : bigint <<PK, FK>>
}

entity "song_lessons" as song_lessons {
    * id : bigint <<PK>>
    --
    difficulty : varchar {EASY, MEDIUM, ORIGINAL}
    chorded_lyrics : oid <<LOB>>
    video_url : varchar
    song_id : bigint <<FK>>
    instrument_id : bigint <<FK>>
}

entity "song_chords" as song_chords <<join>> {
    * song_lesson_id : bigint <<PK, FK>>
    * chord_id : bigint <<PK, FK>>
}

entity "tab_sections" as tab_sections {
    * id : bigserial <<PK>>
    --
    identifier : varchar
    content : oid <<LOB>>
    song_lesson_id : bigint <<FK>>
}

entity "chords" as chords {
    * id : bigint <<PK>>
    --
    * name : varchar <<NN, UQ(name, instrument_id)>>
    * image_url : varchar <<NN>>
    * instrument_id : bigint <<FK, NN, UQ(name, instrument_id)>>
    * open : boolean
    * barre : boolean
    * power_chord : boolean
    * minor : boolean
    * major : boolean
    * seventh : boolean
    * capo : boolean
    * capo_fret : int
}

entity "chord_notes" as chord_notes <<join>> {
    * chord_id : bigint <<FK>>
    note : varchar
}

entity "tunes" as tunes {
    * id : bigint <<PK>>
    --
    * title : varchar <<NN>>
    * instrument_id : bigint <<FK, NN>>
}

entity "tune_notes" as tune_notes <<join>> {
    * tune_id : bigint <<PK, FK>>
    * string_index : int <<PK>>
    --
    * note : varchar <<NN>>
}

' ---------------------------------------------------------------------
' Relaciones
' ---------------------------------------------------------------------

songs ||--o{ song_genre
song_genre }o--|| genres
songs ||--o{ songs_instruments
songs_instruments }o--|| instruments
songs |o--o{ song_lessons : song_id
instruments |o--o{ song_lessons : instrument_id

song_lessons ||--o{ song_chords
song_chords }o--|| chords
song_lessons |o--o{ tab_sections : song_lesson_id
chords ||--o{ chord_notes
instruments ||--o{ chords : instrument_id

' Afinador
instruments ||--o{ tunes : instrument_id
tunes ||--|{ tune_notes : tune_id

note bottom of tune_notes
    Una nota por cuerda, de la más grave
    a la más aguda (string_index = 0, 1...).
    Columna de orden de @OrderColumn.
end note

@enduml
