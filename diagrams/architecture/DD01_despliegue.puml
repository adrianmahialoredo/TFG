@startuml DD-01
title DD-01 - Diagrama de despliegue del sistema (producción)

' Despliegue real de la aplicación publicada. Datos tomados del proyecto:
'   - frontend/package.json, app.json y eas.json: Expo SDK 58, React Native 0.88.1,
'     paquete com.uo289390.toco, APK generado con EAS Build (perfil "preview",
'     distribution internal, buildType apk). La URL del backend se fija con
'     EXPO_PUBLIC_API_URL (https://<servicio>.onrender.com).
'   - render.yaml: servicio web "toco-backend", runtime docker, plan free, región
'     frankfurt, health check /actuator/health.
'   - Dockerfile: imagen eclipse-temurin:23-jre con app.jar (TOCO-0.0.1-SNAPSHOT.jar,
'     Spring Boot 3.4.3); Tomcat embebido en server.port=${PORT}.
'   - application.properties: PostgreSQL de Neon (DB_URL con sslmode=require),
'     HikariCP máx. 10 conexiones, Spring Mail con STARTTLS.
'   - README (Despliegue): Brevo smtp-relay.brevo.com:2525, porque el plan gratuito
'     de Render bloquea los puertos SMTP 25, 465 y 587.
'   - EmailVerificationServiceImpl: el correo se envía en segundo plano
'     (applicationTaskExecutor).
' El entorno de desarrollo (backend y PostgreSQL en localhost, development build
' con Metro) no se dibuja.
skinparam roundcorner 6
skinparam nodesep 50
skinparam ranksep 70
skinparam defaultTextAlignment center
skinparam node {
    BackgroundColor<<device>> #F3F8FF
    BorderColor<<device>> #3D6FA8
    BackgroundColor<<executionEnvironment>> #FFFFFF
}
skinparam cloud {
    BackgroundColor #F3F3F3
    BorderColor #888888
}
skinparam artifact {
    BackgroundColor #FFF4E0
    BorderColor #B07A1F
}
skinparam database {
    BackgroundColor #E6F5E6
    BorderColor #3C8A3C
}
skinparam ArrowColor #555555

' ---------------------------------------------------------------------
' Cliente
' ---------------------------------------------------------------------

node "Móvil Android" <<device>> as phone {
    node "React Native\n(Expo SDK 58, RN 0.88.1)" <<executionEnvironment>> as rn {
        artifact "TOCO app\n(APK com.uo289390.toco)" as app
    }
    database "AsyncStorage\n(caché en disco)" as async
    node "Navegador del móvil\n(expo-web-browser)" <<executionEnvironment>> as browser
    component "Micrófono" <<hardware>> as mic
}

app --> async
app --> mic : react-native-audio-api\n(afinador)
app ..> browser : abre la URL de\nautorización de Spotify

cloud "Expo EAS Build" as eas {
    artifact "APK\n(perfil preview)" as apk
}
apk ..> app : <<deploy>>\ninstalación

' ---------------------------------------------------------------------
' Backend en Render
' ---------------------------------------------------------------------

cloud "Render (plan free, frankfurt)" as render {
    node "Proxy HTTPS :443\n(terminación TLS)" <<executionEnvironment>> as proxy
    node "Contenedor Docker\n(eclipse-temurin:23-jre)" <<executionEnvironment>> as docker {
        node "Tomcat embebido\n:${PORT}" <<executionEnvironment>> as tomcat {
            artifact "app.jar\n(TOCO-0.0.1-SNAPSHOT.jar,\nSpring Boot 3.4.3)" as jar
        }
    }
}
proxy --> tomcat : HTTP

' ---------------------------------------------------------------------
' Servicios externos
' ---------------------------------------------------------------------

cloud "Neon" as neon {
    database "PostgreSQL" as pg
}

cloud "Brevo" as brevo {
    component "SMTP\nsmtp-relay.brevo.com:2525" as smtp
}

cloud "Cloudinary" as cloudinary {
    component "Upload API" as cloudinary_api
}

cloud "YouTube" as youtube {
    component "Reproductor embebido" as youtube_player
}

cloud "Spotify" as spotify {
    component "Spotify Accounts\n(accounts.spotify.com)" as spotify_accounts
    component "Spotify Web API\n(api.spotify.com)" as spotify_api
}

' ---------------------------------------------------------------------
' Comunicaciones
' ---------------------------------------------------------------------

app --> proxy : HTTPS :443 / JSON REST\nAuthorization: Bearer <JWT>
jar --> pg : JDBC sobre TLS\n(sslmode=require, HikariCP máx. 10)
jar --> smtp : SMTP STARTTLS\n(código de verificación, asíncrono)
jar --> spotify_accounts : HTTPS :443\nOAuth2 (tokens)
jar --> spotify_api : HTTPS :443\nREST (Bearer de Spotify)
browser --> spotify_accounts : HTTPS :443\nAuthorization Code Flow
browser --> proxy : HTTPS (redirect_uri)\nGET /api/spotify/callback
app --> cloudinary_api : HTTPS :443\n(subida directa de imágenes\nde perfil y de listas)
app --> youtube_player : HTTPS :443\n(vídeos de canciones,\nlecciones y géneros)

@enduml
