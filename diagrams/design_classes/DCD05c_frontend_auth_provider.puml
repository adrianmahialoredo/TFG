@startuml DCD-05c
title DCD-05c - Diagrama de clases de diseño: frontend (React Native),\nnivel 6: AuthProvider (context)

' Contexto de sesión (context/AuthContext.tsx), usado por todas las pantallas.
' Partes: DCD-05a niveles 7-5 (pantalla de canción); DCD-05b dependencias de sus hooks con
' los niveles 4 y 3; DCD-05c nivel 6 (AuthProvider); DCD-05d nivel 4 (Entity Stores);
' DCD-05e/f/g nivel 3 (repositorios de canciones, de items con EntityCache y de
' autenticación); DCD-05h nivel 2 (local); DCD-05i nivel 1 (services).
' Fuentes: context/AuthContext.tsx.
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 20
skinparam ranksep 50
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<screen>> #E3F0FF
    BorderColor<<screen>> #3D6FA8
    BackgroundColor<<hook>> #EAF2FB
    BorderColor<<hook>> #3D6FA8
    BackgroundColor<<context>> #EAF2FB
    BorderColor<<context>> #3D6FA8
    BackgroundColor<<store>> #F3EAFB
    BorderColor<<store>> #7A4FA8
    BackgroundColor<<repository>> #E6F5E6
    BorderColor<<repository>> #3C8A3C
}
hide empty members

package "Nivel 6 - Context" {
    class AuthProvider <<context>> {
        user : UserDTO | null
        token : string | null
        isAuthenticated : boolean
        isReady : boolean
        isLoading : boolean
        loading : boolean
        login(identifier, password) : Promise<void>
        logout() : Promise<void>
        - loadInitialData() : void
        --
        + {static} useAuth() : AuthContextType
    }
    note right of AuthProvider : isLoading: login en curso;\nloading: restauración de la sesión.\nuseAuth() se exporta del mismo\nmódulo (context/AuthContext.tsx)
}

package "Nivel 4 - Entity Stores (ver DCD-05d)" {
    class "useAuthStore /\nuseUserEntitiesStore" as sessionStores <<store>>
}

package "Nivel 3 - Repositories (ver DCD-05e/f/g)" {
    class "authRepository /\nuserRepository /\ngenreRepository" as sessionRepos <<repository>>
    class "itemRepository" as contentRepos <<repository>>
}

AuthProvider --> sessionStores : token, currentUserId,\nisHydrated, users
AuthProvider --> sessionRepos : login / logout,\nuserRepository.getById,\ngenreRepository.getAll
AuthProvider --> contentRepos : itemRepository.\ngetCatalog

@enduml
