@startuml DCD-05a
title DCD-05a - Diagrama de clases de diseño: frontend (React Native),\nniveles 7 a 5 (UI, hooks, context y Screen Store)

' Arquitectura en 7 niveles de frontend/src (architecture.md §12 y frontend/bible.md),
' mostrada con el recorrido de la pantalla de canción (SongScreen). El código es
' TypeScript funcional: cada "clase" es un módulo, hook o store de Zustand, con sus
' funciones exportadas como operaciones. Cada recurso (genre, lesson, itemList, tune...)
' repite el mismo patrón: <x>Service -> <x>Local -> <x>Repository -> use<X>EntitiesStore.
' Un nivel solo depende de los de debajo; types, constants y utils son transversales.
' Partes: DCD-05a niveles 7-5 (este); DCD-05b nivel 4 (Entity Stores);
'         DCD-05c nivel 3 (repositories); DCD-05d niveles 2-1 (local, services).
' Fuentes: screens/SongScreen.tsx, hooks/useSong.ts, hooks/useInstruments.ts,
'   context/AuthContext.tsx, stores/ui/songScreen.store.ts.
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 20
skinparam ranksep 60
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<screen>> #E3F0FF
    BorderColor<<screen>> #3D6FA8
    BackgroundColor<<hook>> #EAF2FB
    BorderColor<<hook>> #3D6FA8
    BackgroundColor<<context>> #EAF2FB
    BorderColor<<context>> #3D6FA8
    BackgroundColor<<store>> #F3EAFB
    BorderColor<<store>> #7A4FA8
    BackgroundColor<<repository>> #E6F5E6
    BorderColor<<repository>> #3C8A3C
}
hide empty members

' =====================================================================
' Nivel 7 - UI
' =====================================================================

package "Nivel 7 - UI (screens, components)" {
    class SongScreen <<screen>> {
        + render() : JSX.Element
    }
    note right of SongScreen : Solo pinta y consume hooks:\nselector de instrumento y dificultad,\nletra con acordes, vídeo, tablaturas
}

' =====================================================================
' Nivel 6 - Hooks y Context
' =====================================================================

package "Nivel 6 - Hooks / Context" {
    class useSong <<hook>> {
        + useSong(songId : string)
        --
        song : SongDTO
        loading : boolean
        selectedLesson : SongLessonDTO
        selectedInstrumentId : string
        chords : ChordDTO[]
        tabSections : TabSectionDTO[]
        availableInstruments / availableDifficulties
        parsedLyrics
        changeInstrument(id : string) : void
        changeDifficulty(d : DifficultyLevel) : void
    }
    note left of useSong : Convierte IDs en objetos (useMemo)\nleyendo siempre de las stores.\nPor defecto: primer instrumento favorito\ndel usuario con lecciones y, si es\navanzado, la dificultad ORIGINAL

    class useInstrumentsByIds <<hook>> {
        + useInstrumentsByIds(ids : string[]) : InstrumentDTO[]
    }

    class AuthProvider <<context>> {
        user : UserDTO | null
        token : string | null
        isAuthenticated : boolean
        isReady : boolean
        isLoading : boolean
        loading : boolean
        login(identifier, password) : Promise<void>
        logout() : Promise<void>
        - loadInitialData() : void
        --
        + {static} useAuth() : AuthContextType
    }
    note right of AuthProvider : isLoading: login en curso;\nloading: restauración de la sesión.\nuseAuth() se exporta del mismo\nmódulo (context/AuthContext.tsx)
}

' =====================================================================
' Nivel 5 - Screen Store
' =====================================================================

package "Nivel 5 - Screen Store" {
    class useSongScreenStore <<store>> {
        isLoading : boolean
        error : string | null
        selectedInstrumentId : string | null
        selectedDifficulty : DifficultyLevel | null
        setLoading(loading : boolean) : void
        setError(error : string | null) : void
        setInstrument(id : string) : void
        setDifficulty(d : DifficultyLevel) : void
        reset() : void
    }
}

' Niveles inferiores: detallados en DCD-05b, DCD-05c y DCD-05d
package "Nivel 4 - Entity Stores (ver DCD-05b)" {
    class "useSongEntitiesStore /\nuseSongLessonEntitiesStore /\nuseChordEntitiesStore /\nuseTabSectionEntitiesStore" as songStores <<store>>
    class useInstrumentEntitiesStore <<store>>
    class "useAuthStore /\nuseUserEntitiesStore" as sessionStores <<store>>
}

package "Nivel 3 - Repositories (ver DCD-05c)" {
    class "songRepository /\nitemRepository" as contentRepos <<repository>>
    class instrumentRepository <<repository>>
    class "authRepository /\nuserRepository /\ngenreRepository" as sessionRepos <<repository>>
}

' =====================================================================
' Dependencias
' =====================================================================

SongScreen --> useSong

useSong --> useSongScreenStore
useSong --> useInstrumentsByIds
useSong --> songStores : song, lessons,\nchords, tabSections
useSong --> sessionStores : usuario actual: nivel e\ninstrumentos favoritos
useSong --> contentRepos : songRepository.getById,\nitemRepository.markAsAccessed
useInstrumentsByIds --> useInstrumentEntitiesStore
useInstrumentsByIds --> instrumentRepository : getAllById (los que faltan)

AuthProvider --> sessionStores : token, currentUserId,\nisHydrated, users
AuthProvider --> sessionRepos : login / logout,\nuserRepository.getById,\ngenreRepository.getAll
AuthProvider --> contentRepos : itemRepository.getCatalog

songStores -[hidden]down- contentRepos

@enduml
