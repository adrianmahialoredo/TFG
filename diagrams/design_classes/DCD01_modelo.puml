@startuml DCD-01
title DCD-01 - Diagrama de clases de diseño: modelo de dominio (com.uo289390.toco.model)

' Entidades JPA tal y como están en el código (com.uo289390.toco.model). Se muestran los
' atributos persistentes con su tipo Java, las relaciones con su multiplicidad y nombre de
' rol, y los métodos de dominio. Se omiten getters/setters (Lombok) y los timestamps de
' auditoría salvo createdAt de Item.
' Esquema físico equivalente: diagrams/er.puml. Reglas: architecture.md §2.
'
' Notas de diseño:
'   - IDs asignados a mano (vienen de data/*.json) en Item, Instrument, Chord, SongLesson y Tune;
'     IDENTITY en User, ItemList, LessonSection, TabSection, SpotifyUser y Settings.
'   - Las colecciones del dominio musical son Set (sin duplicados); List solo cuando el orden
'     es parte del dato (ItemList.items, Lesson.sections, SongLesson.tabSections, Chord.notes,
'     Tune.notes).
'   - Los favoritos del usuario viven en Preferences (relación 1:1 con clave compartida, @MapsId).
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 55
skinparam ranksep 60
skinparam class {
    BackgroundColor<<entity>> #FFF4E0
    BorderColor<<entity>> #B07A1F
    BackgroundColor<<enum>> #F3F3F3
    BackgroundColor<<interface>> #E3F0FF
    BorderColor<<interface>> #3D6FA8
}
hide empty members

' ---------------------------------------------------------------------
' Contratos
' ---------------------------------------------------------------------

interface "Identifiable<ID>" as Identifiable <<interface>> {
    + getId() : ID
}
note top of Identifiable : utils.Identifiable: las entidades\nque entran en rankings (getTopNMostRepeated)

interface "UserDetails" as UserDetails <<interface>> {
    + getAuthorities() : Collection<GrantedAuthority>
}
note top of UserDetails : Spring Security

' ---------------------------------------------------------------------
' Jerarquía del catálogo (@Inheritance(JOINED): tabla items + una por subtipo)
' ---------------------------------------------------------------------

abstract class Item <<entity>> {
    # id : Long {PK, asignado}
    # title : String {NotBlank}
    # imageUrl : String
    # level : int {1..5}
    # createdAt : LocalDateTime
    # type : Item.Type
    --
    + equals(o : Object) : boolean {por id, instanceof}
    + hashCode() : int
}
note right of Item : @Entity\n@Inheritance(strategy = JOINED)\nComparten espacio de IDs

enum "Item.Type" as ItemType <<enum>> {
    Song
    Lesson
    Genre
    InstrumentGenre
}

class Song <<entity>> {
    - artist : String
    - decade : String
    - popular : boolean
    - newSong : boolean
    - genreClassic : boolean
    - genrePopular : boolean
    - genreNew : boolean
    - artistClassic : boolean
    - artistPopular : boolean
    - artistNew : boolean
}

class Lesson <<entity>> {
    - belongsToGenre : boolean
    - belongsToInstrument : boolean
    - belongsToInstrumentGenre : boolean
    - indexInInstrumentGenre : int
    - popular : boolean
    - genrePopular : boolean
    - instrumentPopular : boolean
    --
    + addSection(section : LessonSection) : void
    + joinInstrumentGenre(ig : InstrumentGenre, index : int) : void
    + leaveInstrumentGenre() : void
}

class Genre <<entity>> {
    - description : String {TEXT}
    - bannerUrl : String
    - welcomeIntroVideoId : String
    - welcomeSongVideoId : String
    --
    + setLessons(lessons : Collection<Lesson>) : void
}

class InstrumentGenre <<entity>> {
    --
    + setLessons(lessons : Collection<Lesson>) : void
}
note bottom of InstrumentGenre : setLessons une las lecciones en orden\n(su índice = su posición) y desvincula\nlas que salen. Dueño de la relación: Lesson

' ---------------------------------------------------------------------
' Contenido de canciones y lecciones
' ---------------------------------------------------------------------

class SongLesson <<entity>> {
    - id : Long {PK, asignado}
    - difficulty : SongLesson.DifficultyLevel
    - chordedLyrics : String
    - videoUrl : String
    --
    + equals(o : Object) : boolean
    + hashCode() : int
}

enum "SongLesson.DifficultyLevel" as DifficultyLevel <<enum>> {
    EASY
    MEDIUM
    ORIGINAL
    --
    + {static} from(value : String) : DifficultyLevel
}

class Chord <<entity>> {
    - id : Long {PK, asignado}
    - name : String {unique (name, instrument)}
    - notes : List<String>
    - imageUrl : String
    - open : boolean
    - barre : boolean
    - powerChord : boolean
    - minor : boolean
    - major : boolean
    - seventh : boolean
    - capo : boolean
    - capoFret : int
    --
    + equals(o : Object) : boolean
    + hashCode() : int
}

class TabSection <<entity>> {
    - id : Long {PK}
    - identifier : String
    - content : String
}

class LessonSection <<entity>> {
    - id : Long {PK}
    - title : String
    - htmlContent : String {TEXT}
    - videoUrl : String
    - orderIndex : int
}

class Instrument <<entity>> {
    - id : Long {PK, asignado}
    - name : String {unique}
    - imageUrl : String
    --
    + equals(o : Object) : boolean
    + hashCode() : int
}

class Tune <<entity>> {
    + {static} NOTE_PATTERN : String = "^[A-G]#?[0-8]$"
    - id : Long {PK, asignado}
    - title : String
    - notes : List<String> {@OrderColumn string_index}
    --
    + equals(o : Object) : boolean
    + hashCode() : int
}

' ---------------------------------------------------------------------
' Usuario y listas
' ---------------------------------------------------------------------

class User <<entity>> {
    - id : Long {PK}
    - email : String {unique}
    - username : String {unique}
    - password : String {BCrypt}
    - name : String
    - profileImageUrl : String
    - role : Role = USER
    - difficultyLevel : int = 1 {0..5}
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
    --
    + getAuthorities() : Collection<GrantedAuthority>
    + hasItemInLists(item : Item) : boolean
    + getAllFromItemListsOfType(type : Class<T>) : Set<T>
    + getIdsExcludedFromRecommendationsOfType(type : Class<T>) : Set<Long>
    + getTopGenresFromItemLists(topN : int) : List<Genre>
    + getTopInstrumentsFromItemLists(topN : int) : List<Instrument>
    + getTopArtistsFromItemLists(topN : int) : List<String>
}

enum Role <<enum>> {
    ADMIN
    USER
}

class Preferences <<entity>> {
    + {static} MIN_N_FAVOURITE_GENRES : int = 2
    + {static} MIN_N_FAVOURITE_INSTRUMENTS : int = 2
    - id : Long {PK = FK user_id, @MapsId}
    - difficultyLevel : int
}
note bottom of Preferences : difficultyLevel es histórico: el nivel\nque se usa es User.difficultyLevel

class SpotifyUser <<entity>> {
    - id : Long {PK}
    - spotifyUserId : String {unique}
    - accessToken : String
    - refreshToken : String
    - tokenExpiration : Instant
}

class ItemList <<entity>> {
    - id : Long {PK}
    - name : String
    - imageUrl : String
    --
    + setItems(items : Collection<? extends Item>) : void {deduplica}
    + addItem(item : Item) : boolean {ignora repetidos}
    + removeItem(item : Item) : void
    + getSize() : int
    + containsItem(item : Item) : boolean
    + getItemsOfType(type : Class<T>) : Set<T>
    + getOnlyItemOfType(type : Class<T>) : Optional<T>
    + getSongs() : Set<Song>
    + getGenres() : Set<Genre>
    + getOnlyGenre() : Optional<Genre>
    + getOnlyInstrumentGenre() : Optional<InstrumentGenre>
    + getMainGenreFromSongs() : Optional<Genre>
    + getMainGenreFromInstrumentGenres() : Optional<Genre>
    + getMainGenreFromLessons() : Optional<Genre>
    + getMainGenreFromItems() : Optional<Genre>
    + getMainInstrumentFromItems() : Optional<Instrument>
    + getTopGenresFrom{Songs, InstrumentGenres, Lessons, Items}(topN : int) : List<Genre>
    + getTopInstrumentsFrom{Songs, Lessons, Items}(topN : int) : List<Instrument>
    + getGenreOccurrencesFromItems() : List<Genre>
    + getInstrumentOccurrencesFromItems() : List<Instrument>
    - getTopN(topN : int, extractor) : List<T>
}
note right of ItemList : Todos los rankings pasan por getTopN\n(-> Utils.getTopNMostRepeated) con un\nextractor por tipo de item

class Settings <<entity>> {
    - id : Long {PK}
    - notifications : boolean
    - sound : boolean
}
note bottom of Settings : Tabla sin uso en el código\n(ninguna clase la referencia)

' ---------------------------------------------------------------------
' Herencia y realizaciones
' ---------------------------------------------------------------------

Identifiable <|.. Item
Identifiable <|.. Instrument
Identifiable <|.. Chord
Identifiable <|.. SongLesson
Identifiable <|.. Tune
UserDetails <|.. User

Item <|-- Song
Item <|-- Lesson
Item <|-- Genre
Item <|-- InstrumentGenre
Item --> ItemType
SongLesson --> DifficultyLevel
User --> Role

' ---------------------------------------------------------------------
' Asociaciones
' ---------------------------------------------------------------------

Song "*" --> "*" Genre : genres
Song "*" --> "*" Instrument : instruments
Song "1" *-- "*" SongLesson : lessons\n{Set, @OrderBy id}
SongLesson "*" --> "*" Chord : chords\n{Set, @OrderBy id}
SongLesson "1" *-- "*" TabSection : tabSections\n{List}
SongLesson "*" --> "0..1" Instrument : instrument
Chord "*" --> "1" Instrument : instrument
note bottom of Chord
  Los chords de una SongLesson deben ser de su
  instrument (EntityResolver.resolveChords(ids, instrument),
  400 si no).
end note

Lesson "*" -- "0..1" Genre : genre / lessons
Lesson "*" -- "0..1" InstrumentGenre : instrumentGenre / lessons\n{@OrderBy indexInInstrumentGenre}
Lesson "*" --> "0..1" Instrument : instrument
Lesson "1" *-- "*" LessonSection : sections\n{List, @OrderBy orderIndex}

InstrumentGenre "*" --> "1" Instrument : instrument
InstrumentGenre "*" --> "1" Genre : genre
Tune "*" --> "1" Instrument : instrument

User "1" *-- "*" ItemList : itemLists / user
ItemList "*" --> "*" Item : items\n{List ordenada, sin duplicados}
User "1" *-- "1" Preferences : preferences / user
Preferences "*" --> "2..*" Genre : favoriteGenres
Preferences "*" --> "2..*" Instrument : favoriteInstruments
User "1" *-- "0..1" SpotifyUser : spotifyUser / user\n{orphanRemoval}

@enduml
