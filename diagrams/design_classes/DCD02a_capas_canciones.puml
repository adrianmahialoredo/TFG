@startuml DCD-02a
title DCD-02a - Diagrama de clases de diseño: capas del backend (1/6) -\ncanciones: controlador e interfaz del servicio

' Capas controller -> service -> repository, mostradas con dos recursos representativos:
' canciones (CRUD + filtros de catálogo, DCD-02a/b) y listas de estudio (propiedad del
' usuario + método de dominio, DCD-02c/d). Las utilidades transversales (EntityResolver, Utils, mappers,
' GlobalExceptionHandler, RecommendationConstants) se detallan en DCD-02e/f.
' El resto de recursos (Genre, Lesson, InstrumentGenre, Chord, Tune...) siguen el mismo patrón:
' XController -> XService (interfaz) <|.. XServiceImpl -> XRepository extends JpaRepository<X, Long>.
' Recomendaciones: DCD-03. Seguridad: DCD-04. Entidades: DCD-01a-e.
' Reglas y nomenclatura: architecture.md §1, §3-§7.
' Fuentes: controller/SongController.java, service/SongService.java, SongServiceImpl.java,
'          repository/SongRepository.java
' Seis partes: DCD-02a/b canciones (controlador e interfaz / implementación y repositorio),
' DCD-02c/d listas de estudio (ídem), DCD-02e manejo de errores y EntityResolver,
' DCD-02f Utils, constantes y mappers.
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 20
skinparam ranksep 50
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<RestController>> #E3F0FF
    BorderColor<<RestController>> #3D6FA8
    BackgroundColor<<Service>> #E6F5E6
    BorderColor<<Service>> #3C8A3C
    BackgroundColor<<interface>> #F4FBF4
    BorderColor<<interface>> #3C8A3C
    BackgroundColor<<Repository>> #FFF4E0
    BorderColor<<Repository>> #B07A1F
    BackgroundColor<<Component>> #F3F3F3
}
hide empty members

package "controller" {
    class SongController <<RestController>> {
        + getAll() : ResponseEntity<List<SongDTO>>
        + getByIds(ids : List<Long>) : ResponseEntity<List<SongDTO>>
        + getById(id : Long) : ResponseEntity<SongDTO>
        + getByDecade(decade : String) : ResponseEntity<List<SongDTO>>
        + getPopularForGenre(genreId : Long) : ResponseEntity<List<SongDTO>>
        + getClassicForGenre(genreId : Long) : ResponseEntity<List<SongDTO>>
        + getNewForGenre(genreId : Long) : ResponseEntity<List<SongDTO>>
        + getPopular(limit : Integer) : ResponseEntity<List<SongDTO>>
        + getNew(limit : Integer) : ResponseEntity<List<SongDTO>>
        + getNewForArtists(limit : Integer, params : Map<String,String>) : ResponseEntity<List<SongDTO>>
        + getPopularForArtists(limit : Integer, params : Map<String,String>) : ResponseEntity<List<SongDTO>>
        + create(dto : SongDTO) : ResponseEntity<SongDTO>
        + update(id : Long, dto : SongDTO) : ResponseEntity<SongDTO>
        + delete(id : Long) : ResponseEntity<Void>
    }
    note top of SongController : @RequestMapping("/api/songs")\nEscrituras solo ADMIN (SecurityConfig)\nby-artists: los artistas llegan como\nartist1..artist10 en params
}

package "service" {
    interface SongService <<interface>> {
        + findAll() : List<SongDTO>
        + findByIds(ids : List<Long>) : List<SongDTO>
        + findById(id : Long) : Optional<SongDTO>
        + findByDecade(decade : String) : List<SongDTO>
        + findPopular(limit : Integer) : List<SongDTO>
        + findNew(limit : Integer) : List<SongDTO>
        + findPopularForGenre(genreId : Long) : List<SongDTO>
        + findClassicForGenre(genreId : Long) : List<SongDTO>
        + findNewForGenre(genreId : Long) : List<SongDTO>
        + findNewForArtists(artists : List<String>, limit : Integer) : List<SongDTO>
        + findPopularForArtists(artists : List<String>, limit : Integer) : List<SongDTO>
        + create(dto : SongDTO) : SongDTO
        + update(id : Long, dto : SongDTO) : Optional<SongDTO>
        + delete(id : Long) : boolean
    }
    class SongServiceImpl <<Service>> <<ver DCD-02b>>
}

SongController --> SongService
SongService <|.. SongServiceImpl

@enduml
