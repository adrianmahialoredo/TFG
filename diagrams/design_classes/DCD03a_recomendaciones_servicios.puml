@startuml DCD-03a
title DCD-03a - Diagrama de clases de diseño: motor de recomendaciones (1/3) - controlador y servicios

' Paquete service.recommendation: un servicio por tipo de item y un servicio combinador
' (ItemRecommendationService). DCD-03a: controlador, interfaces y combinador.
' DCD-03b: implementaciones de los subservicios; DCD-03c: rankings de dominio y utilidades.
' Las recomendaciones de Spotify están en DCD-04.
' Reglas: architecture.md §8 y recommendations.md.
' Fuentes: controller/RecommendationController.java, service/recommendation/*.java
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 35
skinparam ranksep 60
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<RestController>> #E3F0FF
    BorderColor<<RestController>> #3D6FA8
    BackgroundColor<<Service>> #E6F5E6
    BorderColor<<Service>> #3C8A3C
    BackgroundColor<<interface>> #F4FBF4
    BorderColor<<interface>> #3C8A3C
    BackgroundColor<<Component>> #F3F3F3
}
hide empty members

class RecommendationController <<RestController>> {
    - dtoMapper : DtoMapper
    --
    + getForItemList(id : Long) : ResponseEntity<List<ItemDTO>>
    + getForUser(id : Long) : ResponseEntity<List<ItemDTO>>
    + getSongsForUser(id : Long, limit : int) : ResponseEntity<List<SongDTO>>
    + getLessonsForUser(id : Long) : ResponseEntity<List<LessonDTO>>
    + getForGenre(id : Long) : ResponseEntity<List<LessonDTO>>
    + getFavouriteInstrumentGenreCombinationIds(id : Long) : ResponseEntity<List<Long>>
    + getMostUsedGenreInItemListsIds(id : Long) : ResponseEntity<List<Long>>
}
note top of RecommendationController : @RequestMapping("/api/recommendations")\n.../by-item-list/{id}: @ownership.ownsItemList\n.../by-user/{id}: @ownership.isSelf

package "service.recommendation" {
    interface ItemRecommendationService <<interface>> {
        + findForItemList(id : Long) : List<ItemDTO>
        + findForUser(id : Long) : List<ItemDTO>
    }

    class ItemRecommendationServiceImpl <<Service>> {
        - songRecommendationService : SongRecommendationService
        - genreRecommendationService : GenreRecommendationService
        - instrumentGenreRecommendationService : InstrumentGenreRecommendationService
        - lessonRecommendationService : LessonRecommendationService
        - dtoMapper : DtoMapper
    }
    note left of ItemRecommendationServiceImpl
        Junta los cuatro resultados en un
        LinkedHashSet<Item> (sin duplicados):
        canciones / géneros / instrument-genres / lecciones
        - lista: 10 / 1 / 3 / 6
        - usuario (Inicio): 6 / 1 / 2 / 3
        En los dos casos Collections.shuffle para
        mezclar los tipos; después
        DtoMapper.itemsToItemDTOs (DTO de cada subtipo)
    end note

    interface SongRecommendationService <<interface>> {
        + findForItemList(id : Long, limit : int) : SequencedSet<Song>
        + findForUser(id : Long, limit : int) : SequencedSet<Song>
    }
    interface GenreRecommendationService <<interface>> {
        + findForItemList(id : Long, limit : int) : SequencedSet<Genre>
        + findForUser(id : Long, limit : int) : SequencedSet<Genre>
        + findMostUsedInItemListsForUser(id : Long, limit : int) : SequencedSet<Genre>
    }
    interface InstrumentGenreRecommendationService <<interface>> {
        + findForItemList(id : Long, limit : int) : SequencedSet<InstrumentGenre>
        + findForUser(id : Long, limit : int) : SequencedSet<InstrumentGenre>
        + findFavouriteCombinationsForUser(id : Long, limit : int) : SequencedSet<InstrumentGenre>
    }
    interface LessonRecommendationService <<interface>> {
        + findForItemList(id : Long, limit : int) : SequencedSet<Lesson>
        + findForUser(id : Long, limit : int) : SequencedSet<Lesson>
        + findForGenre(id : Long, limit : int) : List<LessonDTO>
    }
}

class "utils.mapper.DtoMapper" as DtoMapper <<Component>> {
        + itemsToItemDTOs(items : Collection<? extends Item>) : List<ItemDTO>
        {method} ...
    }

RecommendationController --> ItemRecommendationService
RecommendationController --> SongRecommendationService
RecommendationController --> GenreRecommendationService
RecommendationController --> InstrumentGenreRecommendationService
RecommendationController --> LessonRecommendationService
RecommendationController --> DtoMapper

ItemRecommendationService <|.. ItemRecommendationServiceImpl
ItemRecommendationServiceImpl --> SongRecommendationService
ItemRecommendationServiceImpl --> GenreRecommendationService
ItemRecommendationServiceImpl --> InstrumentGenreRecommendationService
ItemRecommendationServiceImpl --> LessonRecommendationService
ItemRecommendationServiceImpl --> DtoMapper

SongRecommendationService -[hidden]down- GenreRecommendationService
InstrumentGenreRecommendationService -[hidden]down- LessonRecommendationService
LessonRecommendationService -[hidden]down- DtoMapper

@enduml
