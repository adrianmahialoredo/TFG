@startuml DCD-02c
title DCD-02c - Diagrama de clases de diseño: capas del backend (3/3) - utilidades transversales

' Utilidades que usan todos los XServiceImpl (DCD-02a/b) y el manejador global de errores.
' Fuentes: exception/GlobalExceptionHandler.java, utils/EntityResolver.java, Utils.java,
'          RecommendationConstants.java, utils/mapper/DtoMapper.java, EntityMapper.java,
'          service/SpotifyAuthServiceImpl.java (userRepository.findById)
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 40
skinparam ranksep 50
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<RestController>> #E3F0FF
    BorderColor<<RestController>> #3D6FA8
    BackgroundColor<<Repository>> #FFF4E0
    BorderColor<<Repository>> #B07A1F
    BackgroundColor<<Component>> #F3F3F3
    BackgroundColor<<RestControllerAdvice>> #FDECEC
    BorderColor<<RestControllerAdvice>> #B03A3A
}
hide empty members

class "exception.GlobalExceptionHandler" as GlobalExceptionHandler <<RestControllerAdvice>> {
        {field} todos devuelven ResponseEntity<Map<String,Object>>
        --
        + handleBadCredentials(ex) {401}
        + handleAccessDenied(ex) {403}
        + handleIllegalArgument(ex) {400}
        + handleEntityNotFound(ex) {404}
        + handleValidation(ex) {400 + errores por campo}
        + handleNotReadable(ex) {400}
        + handleTypeMismatch(ex) {400}
        + handleGeneric(ex)
    }
    note left of GlobalExceptionHandler : handleGeneric: si la excepción es un\nErrorResponse devuelve su estado; si no, 500

class "XController" as XController <<RestController>>
note left of XController : SongController, ItemListController...\n(DCD-02a/b)

package "utils" {
    class EntityResolver <<Component>> {
        + {static} findX(id : Long) : Optional<X>
        + {static} resolveX(id : Long) : X
        + {static} resolveXs(ids : List<Long>) : Set<X>
        + {static} resolveChords(ids : List<Long>, instrument : Instrument) : Set<Chord>
    }
    note bottom of EntityResolver : X = Song, Item, ItemList, User... (una terna por entidad).\nRecibe los repositorios por constructor y los guarda en\ncampos estáticos: punto común de findById (excepción:\nSpotifyAuthServiceImpl usa userRepository.findById).\nresolveX: id null -> IllegalArgumentException (400),\nno existe -> EntityNotFoundException (404).\nresolveChords(ids, instrument): 400 si un acorde\nno es de ese instrumento

    class Utils {
        + {static} idsToExclude(ids : Collection<Long>) : Collection<Long>
        + {static} resolvePageable(limit : Integer) : Pageable
        + {static} getTopNMostRepeated(items : List<T>, n : int) : List<T>
        + {static} subtract(candidates, toRemove) : Set<T>
    }

    class RecommendationConstants <<final>> {
        + {static} N_ITEM_LISTS_TO_EXCLUDE_FROM_RECOMMENDATIONS : int = 3
        + {static} DEFAULT_N_SONGS_BY_ARTISTS : int = 10
        + {static} MAX_N_SONGS_BY_ARTISTS : int = 50
        + {static} MAX_N_ARTISTS_IN_SONGS_BY_ARTISTS : int = 10
        {field} ... (resto de tamaños: DCD-03)
    }

    package "mapper" {
        class DtoMapper <<Component>> {
            + songToSongDto(song : Song) : SongDTO
            + itemListToItemListDto(list : ItemList) : ItemListDTO
            + itemToItemDto(item : Item) : ItemDTO
            + itemsToItemDTOs(items : Collection<? extends Item>) : List<ItemDTO>
            + itemToItemSummaryDto(item : Item) : ItemSummaryDTO
            {method} ...
        }
        note bottom of DtoMapper : entidad -> DTO; las relaciones viajan\ncomo IDs (genreIds, lessonIds...)

        class EntityMapper <<Component>> {
            + songDtoToSong(dto, genres, instruments, lessons) : Song
            + itemListDtoToItemList(dto, user, items) : ItemList
            {method} ...
        }
        note bottom of EntityMapper : DTO -> entidad; recibe las relaciones ya\nresueltas (Set<Genre>, Set<Instrument>, Set<SongLesson>;\nUser, Collection<? extends Item>), sin repositorios
    }
}

interface "repository.XRepository" as XRepository <<Repository>>

GlobalExceptionHandler .up.> XController : <<intercepta>>
GlobalExceptionHandler -[hidden]down- Utils
Utils -[hidden]right- RecommendationConstants
Utils -[hidden]down- EntityResolver
EntityResolver -[hidden]down- DtoMapper
EntityResolver -left-> XRepository : 14 repositorios\n(campos estáticos)

@enduml
