@startuml DCD-05g
title DCD-05g - Diagrama de clases de diseño: frontend (React Native),\nnivel 3: repositorio de autenticación

' Partes: DCD-05a niveles 7-5 (pantalla de canción); DCD-05b dependencias de sus hooks con
' los niveles 4 y 3; DCD-05c nivel 6 (AuthProvider); DCD-05d nivel 4 (Entity Stores);
' DCD-05e/f/g nivel 3 (repositorios de canciones, de items con EntityCache y de
' autenticación); DCD-05h nivel 2 (local); DCD-05i nivel 1 (services).
' Cada recurso (genre, lesson, itemList, tune...) repite el patrón
' <x>Service -> <x>Local -> <x>Repository -> use<X>EntitiesStore; aquí se muestra
' el de canciones, el de items (catálogo, feeds, recientes) y el de autenticación.
' Fuentes: repositories/auth.repository.ts.
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 12
skinparam ranksep 45
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<store>> #F3EAFB
    BorderColor<<store>> #7A4FA8
    BackgroundColor<<repository>> #E6F5E6
    BorderColor<<repository>> #3C8A3C
    BackgroundColor<<local>> #FFF4E0
    BorderColor<<local>> #B07A1F
    BackgroundColor<<service>> #FDF7E3
    BorderColor<<service>> #B07A1F
    BackgroundColor<<utils>> #F3F3F3
    BackgroundColor<<external>> #FFFFFF
    BorderColor<<external>> #888888
}
hide empty members

package "Nivel 3 - Repositories" {
    class authRepository <<repository>> {
        + login(identifier, password) : Promise<{token, user}>
        + requestVerificationCode(email : string) : Promise<void>
        + register(formData, code : string) : Promise<{token, user}>
        + requestPasswordResetCode(email : string) : Promise<void>
        + verifyPasswordResetCode(email, code) : Promise<void>
        + resetPassword(email, code, newPassword) : Promise<void>
        + logout() : Promise<void>
    }
    note top of authRepository : logout limpia la RAM (clearAuth,\nclearUsers, clearItemLists) y del\ndisco los datos del usuario y los\níndices personalizados (Spotify,\nrecomendadas, artistas favoritos)
}

package "Nivel 4 - Entity Stores (ver DCD-05d)" {
    class "useAuthStore /\nuseUserEntitiesStore /\nuseItemListEntitiesStore" as sessionStores <<store>>
}

class "songLocal" as songLocal <<local>> <<ver DCD-05h>>
class "authService" as authService <<service>> <<ver DCD-05i>>

authRepository --> authService
authRepository --> sessionStores
authRepository --> songLocal : removeQueryIndexes

' Solo para apilar (si no, el diagrama es demasiado ancho)
songLocal -[hidden]down- authService

@enduml
