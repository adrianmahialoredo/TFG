@startuml DCD-04
title DCD-04 - Diagrama de clases de diseño: seguridad, autenticación y Spotify

' Paquetes security y config, la autenticación (login, registro con verificación de
' email) y la integración con Spotify (OAuth2 y recomendaciones). Clases y miembros
' tomados del código; se omiten getters y los métodos privados de ayuda poco relevantes.
' Reglas: architecture.md §9.
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 40
skinparam ranksep 65
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<RestController>> #E3F0FF
    BorderColor<<RestController>> #3D6FA8
    BackgroundColor<<Service>> #E6F5E6
    BorderColor<<Service>> #3C8A3C
    BackgroundColor<<interface>> #F4FBF4
    BorderColor<<interface>> #3C8A3C
    BackgroundColor<<Repository>> #FFF4E0
    BorderColor<<Repository>> #B07A1F
    BackgroundColor<<Configuration>> #F3F3F3
    BackgroundColor<<Component>> #F3F3F3
    BackgroundColor<<external>> #FFFFFF
    BorderColor<<external>> #888888
}
hide empty members

' =====================================================================
' security / config
' =====================================================================

package "config" {
    class SecurityConfig <<Configuration>> {
        - jwtAuthenticationFilter : JwtAuthenticationFilter
        + securityFilterChain(http : HttpSecurity) : SecurityFilterChain
    }
    note top of SecurityConfig
        @EnableMethodSecurity, STATELESS, sin CSRF.
        Públicas: /api/auth/**, /api/spotify/callback,
        /actuator/health, GET /api/genres e /api/instruments.
        Escrituras del catálogo: solo ADMIN.
        Sin token: 401 (la app cierra la sesión).
    end note

    class AppConfig <<Configuration>> {
        + restTemplate() : RestTemplate
        + passwordEncoder() : BCryptPasswordEncoder
    }

    class SpotifyProperties <<Configuration>> {
        - clientId : String
        - clientSecret : String
        - redirectUri : String
    }

    class AdminBootstrap <<Component>> {
        - userRepository : UserRepository
        - passwordEncoder : PasswordEncoder
        - email : String
        - username : String
        - password : String
        + run(args : ApplicationArguments) : void
    }
    note bottom of AdminBootstrap : Crea o asciende el ADMIN inicial\n(ADMIN_EMAIL / ADMIN_PASSWORD del .env)
}

package "security" {
    class JwtAuthenticationFilter <<Component>> {
        - {static} BEARER_PREFIX : String
        - {static} ROLE_PREFIX : String
        - jwtUtil : JwtUtil
        # doFilterInternal(request, response, chain) : void
    }
    note left of JwtAuthenticationFilter : Lee "Authorization: Bearer <token>" y,\nsi es válido, rellena el SecurityContext\ncon el userId y ROLE_<rol>

    class JwtUtil <<Component>> {
        + {static} ROLE_CLAIM : String = "role"
        + init() : void
        + generateToken(userId : Long, role : Role) : String
        + extractUserId(token : String) : Optional<Long>
        + extractRole(token : String) : Optional<Role>
        + validateToken(token : String, userId : Long) : boolean
    }

    class OwnershipChecker <<Component>> {
        + isSelf(userId : Long, auth : Authentication) : boolean
        + isOnlySelf(userIds : Collection<Long>, auth : Authentication) : boolean
        + ownsItemList(itemListId : Long, auth : Authentication) : boolean
        + ownsAllItemLists(itemListIds : Collection<Long>, auth : Authentication) : boolean
    }
    note bottom of OwnershipChecker : @Component("ownership"), usado en SpEL:\n@PreAuthorize("hasRole('ADMIN') or\n@ownership.ownsItemList(#id, authentication)").\nNo es suyo -> AccessDeniedException -> 403
}

abstract class OncePerRequestFilter <<external>>
OncePerRequestFilter <|-- JwtAuthenticationFilter

' =====================================================================
' Autenticación
' =====================================================================

package "controller" {
    class AuthController <<RestController>> {
        - userService : UserService
        - emailVerificationService : EmailVerificationService
        + sendVerificationCode(dto : VerificationCodeRequestDto) : ResponseEntity<Void>
        + register(dto : UserDto) : ResponseEntity<LoginResponse>
        + login(dto : LoginRequestDto) : ResponseEntity<LoginResponse>
    }
    note top of AuthController : @RequestMapping("/api/auth")\nregister: checkCode -> register -> consume\n-> login (201 + LoginResponse)

    class SpotifyAuthController <<RestController>> {
        - spotifyAuthService : SpotifyAuthService
        + getLoginUrl() : ResponseEntity<Map<String, String>>
        + callback(code : String, state : String, error : String) : ResponseEntity<String>
        - {static} currentUserId() : Optional<Long>
    }
    note top of SpotifyAuthController : @RequestMapping("/api/spotify")\ngetLoginUrl lee el usuario del SecurityContext;\ncallback (público) lo identifica por el state

    class SpotifyRecommendationController <<RestController>> {
        - spotifyRecommendationService : SpotifyRecommendationService
        + getSongsForUser(userId : Long, limit : int) : ResponseEntity<List<SongDTO>>
        + getItemsForUser(userId : Long) : ResponseEntity<List<ItemDTO>>
    }
}

package "service" {
    interface UserService <<interface>> {
        + register(dto : UserDto) : UserDto
        + login(identifier : String, password : String) : LoginResponse
        + findById(id : Long) : Optional<UserDto>
        + update(id : Long, dto : UserDto) : Optional<UserDto>
        + addFavoriteGenre(userId : Long, genreId : Long) : Optional<UserDto>
        + findTopArtistsForUser(userId : Long, n : int) : Optional<List<String>>
        {method} ...
    }
    class UserServiceImpl <<Service>> {
        ~ {static} INVALID_CREDENTIALS : String = "Invalid credentials"
        - userRepository : UserRepository
        - passwordEncoder : BCryptPasswordEncoder
        - jwtUtil : JwtUtil
        - dtoMapper : DtoMapper
        - entityMapper : EntityMapper
    }
    note bottom of UserServiceImpl : login: findByEmail, si no findByUsername;\nmismo 401 para usuario inexistente\ny contraseña errónea

    interface EmailVerificationService <<interface>> {
        + sendCode(email : String) : void
        + checkCode(email : String, code : String) : void
        + consume(email : String) : void
    }
    class EmailVerificationServiceImpl <<Service>> {
        - {static} CODE_DIGITS : int = 6
        - random : SecureRandom
        - pendingCodes : Map<String, PendingCode>
        - userRepository : UserRepository
        - emailService : EmailService
        - clock : Clock
    }
    note bottom of EmailVerificationServiceImpl : Código en memoria: caduca a los 10 min,\n5 intentos, reenvío tras 60 s (429)

    interface EmailService <<interface>> {
        + sendVerificationCode(to : String, code : String, minutes : long) : void
    }
    class EmailServiceImpl <<Service>> {
        - mailSender : ObjectProvider<JavaMailSender>
        - from : String
    }

    interface SpotifyAuthService <<interface>> {
        + buildAuthorizationUrl(userId : Long) : String
        + handleCallback(code : String, state : String) : void
        + getValidAccessToken(userId : Long) : String
    }
    class SpotifyAuthServiceImpl <<Service>> {
        - {static} STATE_TTL : Duration
        - {static} TOKEN_REFRESH_MARGIN : Duration
        - {static} SPOTIFY_TOKEN_URL : String
        - restTemplate : RestTemplate
        - spotifyUserRepository : SpotifyUserRepository
        - userRepository : UserRepository
        - spotifyProperties : SpotifyProperties
        - pendingAuthorizations : Map<String, PendingAuthorization>
        - unlinkFromOtherUser(spotifyUserId : String, user : User) : void
        - refreshAccessToken(spotifyUser : SpotifyUser) : void
    }
    note bottom of SpotifyAuthServiceImpl : state: UUID de un solo uso (10 min).\ngetValidAccessToken renueva con el refreshToken\nsi caduca en < 1 min: @Transactional(REQUIRES_NEW)

    interface SpotifyRecommendationService <<interface>> {
        + findSongsForUser(id : Long, limit : int) : List<SongDTO>
        + findItemsForUser(id : Long) : List<ItemDTO>
    }
    class SpotifyRecommendationServiceImpl <<Service>> {
        - restTemplate : RestTemplate
        - spotifyAuthService : SpotifyAuthService
        - songRepository : SongRepository
        - lessonRepository : LessonRepository
        - instrumentGenreRepository : InstrumentGenreRepository
        - dtoMapper : DtoMapper
        - findSongEntitiesForUser(userId : Long, limit : int) : List<Song>
        - authorizedRequest(userId : Long) : HttpEntity<Void>
        - fetchTopTracks(request, count, timeRange) : List<TitleArtist>
        - fetchTopArtists(request, count, timeRange) : List<String>
        - fetchTopItems(request, endpoint, count, timeRange) : List<Map>
    }
    note bottom of SpotifyRecommendationServiceImpl
        findSongsForUser: top tracks (medium, long y short_term) ->
        SongRepository.findByTitleAndArtistIn (una consulta);
        si faltan, canciones de sus 5 artistas top.
        findItemsForUser: 6 canciones de lo anterior + 3 lecciones de sus
        géneros + 2 instrument-genres (5 géneros x 5 instrumentos más
        repetidos) + el género más repetido; nada de lo que ya está en
        sus listas. Barajado. Cantidades: RecommendationConstants.N_SPOTIFY_*
    end note
}

package "repository" {
    interface UserRepository <<Repository>> {
        + findByEmail(email : String) : Optional<User>
        + findByUsername(username : String) : Optional<User>
        + existsByEmailIgnoreCase(email : String) : boolean
    }
    interface SpotifyUserRepository <<Repository>>
    interface SongRepository <<Repository>>
    interface LessonRepository <<Repository>>
    interface InstrumentGenreRepository <<Repository>>
}

class "Spotify Web API /\nSpotify Accounts" as SpotifyApi <<external>>
class "Servidor SMTP" as Smtp <<external>>

' =====================================================================
' Relaciones
' =====================================================================

SecurityConfig --> JwtAuthenticationFilter
JwtAuthenticationFilter --> JwtUtil
OwnershipChecker ..> EntityResolver : findItemList
class EntityResolver <<Component>>

AuthController --> UserService
AuthController --> EmailVerificationService
UserService <|.. UserServiceImpl
UserServiceImpl --> UserRepository
UserServiceImpl --> JwtUtil
EmailVerificationService <|.. EmailVerificationServiceImpl
EmailVerificationServiceImpl --> EmailService
EmailVerificationServiceImpl --> UserRepository
EmailService <|.. EmailServiceImpl
EmailServiceImpl ..> Smtp : JavaMailSender
AdminBootstrap --> UserRepository

SpotifyAuthController --> SpotifyAuthService
SpotifyAuthService <|.. SpotifyAuthServiceImpl
SpotifyAuthServiceImpl --> SpotifyUserRepository
SpotifyAuthServiceImpl --> UserRepository
SpotifyAuthServiceImpl --> SpotifyProperties
SpotifyAuthServiceImpl ..> SpotifyApi : RestTemplate

SpotifyRecommendationController --> SpotifyRecommendationService
SpotifyRecommendationService <|.. SpotifyRecommendationServiceImpl
SpotifyRecommendationServiceImpl --> SpotifyAuthService
SpotifyRecommendationServiceImpl --> SongRepository
SpotifyRecommendationServiceImpl --> LessonRepository
SpotifyRecommendationServiceImpl --> InstrumentGenreRepository
SpotifyRecommendationServiceImpl ..> SpotifyApi : RestTemplate
AppConfig ..> SpotifyAuthServiceImpl : RestTemplate
AppConfig ..> UserServiceImpl : BCryptPasswordEncoder

@enduml
