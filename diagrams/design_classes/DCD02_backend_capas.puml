@startuml DCD-02
title DCD-02 - Diagrama de clases de diseño: capas del backend

' Capas controller -> service -> repository con sus utilidades transversales, mostradas
' con dos recursos representativos: canciones (CRUD + filtros de catálogo) y listas de
' estudio (propiedad del usuario + método de dominio). El resto de recursos (Genre, Lesson,
' InstrumentGenre, Chord, Tune...) siguen el mismo patrón: XController -> XService
' (interfaz) <|.. XServiceImpl -> XRepository extends JpaRepository<X, Long>.
' Recomendaciones: DCD-03. Seguridad: DCD-04. Entidades: DCD-01.
' Reglas y nomenclatura: architecture.md §1, §3-§7.
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 40
skinparam ranksep 60
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<RestController>> #E3F0FF
    BorderColor<<RestController>> #3D6FA8
    BackgroundColor<<Service>> #E6F5E6
    BorderColor<<Service>> #3C8A3C
    BackgroundColor<<interface>> #F4FBF4
    BorderColor<<interface>> #3C8A3C
    BackgroundColor<<Repository>> #FFF4E0
    BorderColor<<Repository>> #B07A1F
    BackgroundColor<<Component>> #F3F3F3
    BackgroundColor<<RestControllerAdvice>> #FDECEC
    BorderColor<<RestControllerAdvice>> #B03A3A
}
hide empty members

' =====================================================================
' controller
' =====================================================================

package "controller" {
    class SongController <<RestController>> {
        + getAll() : ResponseEntity<List<SongDTO>>
        + getByIds(ids : List<Long>) : ResponseEntity<List<SongDTO>>
        + getById(id : Long) : ResponseEntity<SongDTO>
        + getByDecade(decade : String) : ResponseEntity<List<SongDTO>>
        + getPopular(limit : Integer) : ResponseEntity<List<SongDTO>>
        + getNewForGenre(genreId : Long) : ResponseEntity<List<SongDTO>>
        + getNewForArtists(limit, artists) : ResponseEntity<List<SongDTO>>
        + create(dto : SongDTO) : ResponseEntity<SongDTO>
        + update(id : Long, dto : SongDTO) : ResponseEntity<SongDTO>
        + delete(id : Long) : ResponseEntity<Void>
    }
    note top of SongController : @RequestMapping("/api/songs")\nEscrituras solo ADMIN (SecurityConfig)

    class ItemListController <<RestController>> {
        + getAll() : ResponseEntity<List<ItemListDTO>>
        + getByIds(ids : List<Long>) : ResponseEntity<List<ItemListDTO>>
        + getById(id : Long) : ResponseEntity<ItemListDTO>
        + getIdsForUser(userId : Long) : ResponseEntity<List<Long>>
        + create(dto : ItemListDTO) : ResponseEntity<ItemListDTO>
        + update(id : Long, dto : ItemListDTO) : ResponseEntity<ItemListDTO>
        + delete(id : Long) : ResponseEntity<Void>
        + addItem(listId : Long, itemId : Long) : ResponseEntity<ItemListDTO>
        + removeItem(listId : Long, itemId : Long) : ResponseEntity<ItemListDTO>
    }
    note top of ItemListController : @RequestMapping("/api/item-lists")\n@PreAuthorize("hasRole('ADMIN') or\n@ownership.ownsItemList(#listId, authentication)")
}

package "exception" {
    class GlobalExceptionHandler <<RestControllerAdvice>> {
        + handleBadCredentials(ex) : ResponseEntity {401}
        + handleAccessDenied(ex) : ResponseEntity {403}
        + handleIllegalArgument(ex) : ResponseEntity {400}
        + handleEntityNotFound(ex) : ResponseEntity {404}
        + handleValidation(ex) : ResponseEntity {400 + errores por campo}
        + handleGeneric(ex) : ResponseEntity {500}
    }
}

' =====================================================================
' service
' =====================================================================

package "service" {
    interface SongService <<interface>> {
        + findAll() : List<SongDTO>
        + findByIds(ids : List<Long>) : List<SongDTO>
        + findById(id : Long) : Optional<SongDTO>
        + findByDecade(decade : String) : List<SongDTO>
        + findPopular(limit : Integer) : List<SongDTO>
        + findNewForGenre(genreId : Long) : List<SongDTO>
        + findNewForArtists(artists : List<String>, limit : Integer) : List<SongDTO>
        + create(dto : SongDTO) : SongDTO
        + update(id : Long, dto : SongDTO) : Optional<SongDTO>
        + delete(id : Long) : boolean
    }

    class SongServiceImpl <<Service>> {
        - songRepository : SongRepository
        - genreRepository : GenreRepository
        - instrumentRepository : InstrumentRepository
        - userRepository : UserRepository
        - itemListRepository : ItemListRepository
        - dtoMapper : DtoMapper
    }

    interface ItemListService <<interface>> {
        + findAll() : List<ItemListDTO>
        + findIdsForUser(userId : Long) : List<Long>
        + findByIds(ids : List<Long>) : List<ItemListDTO>
        + findById(id : Long) : Optional<ItemListDTO>
        + create(dto : ItemListDTO) : ItemListDTO
        + update(id : Long, dto : ItemListDTO) : Optional<ItemListDTO>
        + delete(id : Long) : boolean
        + addItem(listId : Long, itemId : Long) : Optional<ItemListDTO>
        + removeItem(listId : Long, itemId : Long) : Optional<ItemListDTO>
    }

    class ItemListServiceImpl <<Service>> {
        - itemListRepository : ItemListRepository
        - songService : SongService
        - dtoMapper : DtoMapper
        - entityMapper : EntityMapper
    }
    note bottom of ItemListServiceImpl : addItem (@Transactional):\nfindItemList(listId) + resolveItem(itemId)\n-> ItemList.addItem(item) -> save

}

' =====================================================================
' repository
' =====================================================================

package "repository" {
    interface "JpaRepository<T, Long>" as JpaRepository <<interface>>

    interface SongRepository <<Repository>> {
        + findByDecade(decade : String) : List<Song>
        + findByPopularTrue(pageable : Pageable) : List<Song>
        + findByGenresIdAndGenreNewTrue(genreId : Long) : List<Song>
        + findByArtistIgnoreCaseAndArtistNewTrueAndIdNotIn(artist, excludedIds, pageable) : List<Song>
        + findByTitleAndArtistIn(pairs : Collection<TitleArtist>) : List<Song> {default}
        {method} ...
    }
    note right of SongRepository : Consultas derivadas del nombre.\nfindByTitleAndArtistIn es un método default\ncon Specification (también extiende\nJpaSpecificationExecutor<Song>)

    interface ItemListRepository <<Repository>>
    interface ItemRepository <<Repository>> {
        + findByTitleContainingIgnoreCase(title : String) : List<Item>
    }
}

' =====================================================================
' utils / mapper
' =====================================================================

package "utils" {
    class EntityResolver <<Component>> {
        + {static} findX(id : Long) : Optional<X>
        + {static} resolveX(id : Long) : X
        + {static} resolveXs(ids : List<Long>) : Set<X>
    }
    note bottom of EntityResolver : X = Song, Item, ItemList, User... (una terna por entidad).\nRecibe los repositorios por constructor y los guarda en\ncampos estáticos: único sitio con repository.findById.\nresolveX: id null -> IllegalArgumentException (400),\nno existe -> EntityNotFoundException (404)

    class Utils {
        + {static} idsToExclude(ids : Collection<Long>) : Collection<Long>
        + {static} resolvePageable(limit : Integer) : Pageable
        + {static} getTopNMostRepeated(items : List<T>, n : int) : List<T>
        + {static} subtract(candidates, toRemove) : Set<T>
    }

    package "mapper" {
        class DtoMapper <<Component>> {
            + songToSongDto(song : Song) : SongDTO
            + itemListToItemListDto(list : ItemList) : ItemListDTO
            + itemToItemDto(item : Item) : ItemDTO
            + itemsToItemDTOs(items : Collection<? extends Item>) : List<ItemDTO>
            + itemToItemSummaryDto(item : Item) : ItemSummaryDTO
            {method} ...
        }
        note bottom of DtoMapper : entidad -> DTO; las relaciones viajan\ncomo IDs (genreIds, lessonIds...)

        class EntityMapper <<Component>> {
            + songDtoToSong(dto : SongDTO) : Song
            + itemListDtoToItemList(dto : ItemListDTO) : ItemList
            {method} ...
        }
        note bottom of EntityMapper : DTO -> entidad; recibe las relaciones\nya resueltas, sin acceder a repositorios
    }
}

' =====================================================================
' Relaciones
' =====================================================================

GlobalExceptionHandler .left.> SongController : <<intercepta>>
GlobalExceptionHandler .left.> ItemListController : <<intercepta>>

SongController --> SongService
ItemListController --> ItemListService

SongService <|.. SongServiceImpl
ItemListService <|.. ItemListServiceImpl
ItemListServiceImpl --> SongService

SongServiceImpl --> SongRepository
SongServiceImpl ..> DtoMapper
SongServiceImpl ..> EntityResolver : <<use>>
SongServiceImpl ..> Utils : <<use>>
ItemListServiceImpl --> ItemListRepository
ItemListServiceImpl ..> DtoMapper
ItemListServiceImpl ..> EntityMapper
ItemListServiceImpl ..> EntityResolver : <<use>>

JpaRepository <|-- SongRepository
JpaRepository <|-- ItemListRepository
JpaRepository <|-- ItemRepository
EntityResolver --> SongRepository
EntityResolver --> ItemListRepository
EntityResolver --> ItemRepository

@enduml
