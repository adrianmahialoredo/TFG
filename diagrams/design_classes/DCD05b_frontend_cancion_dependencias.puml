@startuml DCD-05b
title DCD-05b - Diagrama de clases de diseño: frontend (React Native),\npantalla de canción: dependencias de los hooks (niveles 4 y 3)

' Continuación de DCD-05a (useSong y useInstrumentsByIds se detallan allí).
' Partes: DCD-05a niveles 7-5 (pantalla de canción); DCD-05b dependencias de sus hooks con
' los niveles 4 y 3; DCD-05c nivel 6 (AuthProvider); DCD-05d nivel 4 (Entity Stores);
' DCD-05e/f/g nivel 3 (repositorios de canciones, de items con EntityCache y de
' autenticación); DCD-05h nivel 2 (local); DCD-05i nivel 1 (services).
' Fuentes: hooks/useSong.ts, hooks/useInstruments.ts.
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam nodesep 20
skinparam ranksep 50
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor<<screen>> #E3F0FF
    BorderColor<<screen>> #3D6FA8
    BackgroundColor<<hook>> #EAF2FB
    BorderColor<<hook>> #3D6FA8
    BackgroundColor<<context>> #EAF2FB
    BorderColor<<context>> #3D6FA8
    BackgroundColor<<store>> #F3EAFB
    BorderColor<<store>> #7A4FA8
    BackgroundColor<<repository>> #E6F5E6
    BorderColor<<repository>> #3C8A3C
}
hide empty members
left to right direction

package "Nivel 6 - Hooks (ver DCD-05a)" {
    class useSong <<hook>>
    class useInstrumentsByIds <<hook>>
}

package "Nivel 4 - Entity Stores (ver DCD-05d)" {
    class "useSongEntitiesStore /\nuseSongLessonEntitiesStore /\nuseChordEntitiesStore /\nuseTabSectionEntitiesStore" as songStores <<store>>
    class useInstrumentEntitiesStore <<store>>
    class "useAuthStore /\nuseUserEntitiesStore" as sessionStores <<store>>
}

package "Nivel 3 - Repositories (ver DCD-05e/f/g)" {
    class "songRepository /\nitemRepository" as contentRepos <<repository>>
    class instrumentRepository <<repository>>
}

useSong --> songStores : song, lessons,\nchords, tabSections
useSong --> sessionStores : usuario actual:\nnivel e instrumentos\nfavoritos
useSong --> contentRepos : songRepository.getById,\nitemRepository.\nmarkAsAccessed
useInstrumentsByIds --> useInstrumentEntitiesStore
useInstrumentsByIds --> instrumentRepository : getAllById\n(los que faltan)


@enduml
