{
  "expo": {
    "name": "Toco",
    "slug": "toco",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uo289390.toco"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.uo289390.toco",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-audio",
      "expo-status-bar",
      "expo-video",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "TOCO usa el micrófono para escuchar tu instrumento en el afinador.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "androidForegroundService": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TOCO usa tus fotos para la imagen de tu perfil y de tus listas.",
          "cameraPermission": false,
          "microphonePermission": "TOCO usa el micrófono para escuchar tu instrumento en el afinador."
        }
      ],
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ce556790-b744-4223-af14-81b0e1fe9cea"
      }
    },
    "owner": "adromeister"
  }
}
