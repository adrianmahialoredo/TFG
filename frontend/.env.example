# Copia este fichero a .env (cp .env.example .env) y rellénalo.
# Expo solo expone al código las variables EXPO_PUBLIC_* y las incrusta al
# empaquetar: tras cambiarlas, reinicia Metro con `npx expo start --clear`.

# URL del backend (sin /api al final).
# Si se deja vacía:
#   - Emulador de Android -> http://10.0.2.2:8080 (el PC desde el emulador)
#   - Simulador de iOS    -> http://localhost:8080
# Para un móvil físico, pon la IP local del PC (ipconfig / ifconfig), en la misma wifi:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
EXPO_PUBLIC_API_URL=

# Cloudinary (subida de la foto de perfil y de las listas). Preset sin firmar.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
