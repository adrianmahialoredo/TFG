# =====================================================================================
#  Plantilla de variables locales del backend. Copiar a .env (no se sube a git) y rellenar:
#    cp .env.example .env
#  Spring lo importa desde application.properties y los scripts de scripts/ también lo leen.
#  En Render estas variables se configuran en su panel (ver render.yaml), no aquí.
# =====================================================================================

# --- Base de datos -------------------------------------------------------------------
# Local: jdbc:postgresql://localhost:5432/demo con el usuario postgres (valores por defecto).
DB_PASSWORD=

# --- Administrador inicial -----------------------------------------------------------
# El backend lo crea (o asciende a ADMIN) al arrancar. Solo un ADMIN puede crear/editar/borrar
# contenido del catálogo; los scripts de carga inician sesión con él.
# Si el email ya existe, NO se le cambia la contraseña.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# --- Spotify (https://developer.spotify.com/dashboard) -------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Opcional: vuelta del login por un túnel HTTPS (p. ej. ngrok) para probar desde el móvil.
# Spotify solo acepta HTTPS o 127.0.0.1. Por defecto: http://127.0.0.1:8080/api/spotify/callback
# SPOTIFY_REDIRECT_URI=https://<dominio>.ngrok-free.dev/api/spotify/callback

# --- Email (código de verificación del registro) -------------------------------------
# Sin MAIL_HOST no se envía nada y el código sale en el log del backend (suficiente en desarrollo).
# Brevo: smtp-relay.brevo.com, puerto 2525 (el único que deja abierto Render), usuario y clave SMTP.
# Gmail (solo en local): smtp.gmail.com, 587, con una "contraseña de aplicación".
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=TOCO <no-reply@tudominio.com>   (por defecto: TOCO <MAIL_USERNAME>)

# --- Opcionales ----------------------------------------------------------------------
# Clave de firma de los JWT (mínimo 32 bytes). Vacía usa una clave por defecto insegura, válida
# solo en local. En producción es obligatoria (Render la genera con render.yaml).
# JWT_SECRET_KEY=
# Consultas SQL en el log (por defecto true; false en producción)
# SHOW_SQL=false

# =====================================================================================
#  PRODUCCIÓN (Neon + Render) — descomentar SOLO para trabajar contra prod desde el PC.
#  ¡Cuidado! Con esto activo, clean_db.py y los scripts de carga actúan sobre producción.
# =====================================================================================
# Base de datos de Neon (backend local o clean_db.py contra ella). Sustituye al DB_PASSWORD local.
# DB_URL=jdbc:postgresql://<host>.neon.tech/<base>?sslmode=require
# DB_USERNAME=
# DB_PASSWORD=

# Scripts de carga contra el backend desplegado (por defecto http://localhost:8080).
# ADMIN_EMAIL/ADMIN_PASSWORD tienen que ser los configurados en Render.
# API_BASE_URL=https://<servicio>.onrender.com
