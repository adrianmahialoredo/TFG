# Plantilla de variables locales del backend. Copiar a .env (que no se sube a git) y rellenar.
# Spring lo importa desde application.properties; los scripts de scripts/ también lo leen.

# Contraseña de PostgreSQL (spring.datasource.password)
DB_PASSWORD=
# Opcional: otra base de datos. Por defecto: jdbc:postgresql://localhost:5432/demo y usuario postgres.
# En Neon: DB_URL=jdbc:postgresql://<host>.neon.tech/<base>?sslmode=require
# DB_URL=
# DB_USERNAME=

# Opcional: clave de firma de los JWT (mínimo 32 bytes). Vacía usa una clave por defecto insegura,
# válida solo en local. En producción es obligatoria (Render la genera con render.yaml).
# JWT_SECRET_KEY=

# Opcional: mostrar las consultas SQL en el log (por defecto true; false en producción)
# SHOW_SQL=false

# Credenciales de la app de Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opcional: vuelta del login de Spotify por un túnel HTTPS (p. ej. ngrok) para probar desde el móvil.
# Por defecto: http://127.0.0.1:8080/api/spotify/callback
# SPOTIFY_REDIRECT_URI=https://<dominio>.ngrok-free.dev/api/spotify/callback

# Administrador inicial: el backend lo crea (o asciende a ADMIN) al arrancar. Solo un ADMIN puede
# crear/editar/borrar contenido del catálogo; los scripts de carga de datos inician sesión con él.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# Opcional: dirección del backend para los scripts de carga de datos (scripts/insert_*.py).
# Por defecto: http://localhost:8080
# API_BASE_URL=...

# Envío de emails (código de verificación del registro). Sin MAIL_HOST no se envía nada y el código
# sale en el log del backend, suficiente para desarrollo. Ejemplos de SMTP: Gmail (smtp.gmail.com, 587,
# con una "contraseña de aplicación"), Resend (smtp.resend.com, 587, usuario "resend" y la API key),
# Mailtrap (sandbox para pruebas, no entrega a buzones reales).
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=TOCO <no-reply@tudominio.com>   (por defecto: TOCO <MAIL_USERNAME>)
